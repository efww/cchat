# cchat 설정. 복사해서 고친 뒤 ./install.sh -c <이 파일> 로 설치한다(zsh로 읽으므로 $HOME 사용 가능).
# 저장소의 bin/ config/ launchd/ 안 @@이름@@ 자리에 아래 값이 들어간다.

HOME_DIR=$HOME                        # 설치 기준 홈(~/.local/bin, ~/.config/cchat, ~/Library/...)
BREW=/opt/homebrew/bin                # tmux·ttyd가 있는 폴더
WORKDIR=$HOME                         # 대화(claude)가 열리는 작업 폴더
PERMISSION_MODE=default               # claude 권한 모드. bypassPermissions는 확인 없이 명령 실행 — 접속 인증이 확실할 때만
PORT=7681                             # ttyd 포트(127.0.0.1에만 열림)
FONT_SIZE=14                          # 웹 터미널 글꼴 크기
LAUNCHD_PREFIX=local.cchat            # launchd 서비스 이름 앞부분
PUBLIC_URL=http://127.0.0.1:7681/cchat/   # 안내 문구에 쓰는 접속 주소

# 밖에서 접속: SSH 역방향 통로(비우면 통로 서비스를 설치하지 않음)
TUNNEL_HOST=                          # ~/.ssh/config의 호스트 이름
TUNNEL_REMOTE_PORT=9130               # 그 호스트에서 열 포트(127.0.0.1)

AUTO_UPDATE=0                         # 1이면 매일 새벽 claude CLI 자동 업데이트 서비스 설치
