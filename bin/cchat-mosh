#!/usr/bin/env python3
"""Termux(안드)에서 mosh로 cchat에 붙는다. 폰 Termux에 복사해서 쓰는 스크립트(맥에서는 안 씀).
  cchat-mosh 사용자@맥주소            예: cchat-mosh me@100.64.0.1
  설치(Termux): pkg install -y mosh python && ssh 사용자@맥주소 cat .local/bin/cchat-mosh > $PREFIX/bin/cchat-mosh && chmod +x $PREFIX/bin/cchat-mosh

왜 필요한가: claude는 마우스 '모든 움직임' 모드(1003)를 켠다. tmux를 ssh로 직접 보면 1000·1002·1003을 차례로 보내
Termux가 1000·1002를 알아듣지만, mosh는 마지막 모드(1003)만 넘긴다. Termux는 1003을 모르므로 마우스 추적이 꺼진 것으로
보고 탭(터치)을 보내지 않고, 스와이프는 ↑↓ 키로 바꿔 claude 입력 기록이 넘어간다.
이 스크립트는 mosh 출력의 1003 켜기 앞에 1002 켜기를 끼워 넣어 Termux가 터치·스크롤을 tmux로 보내게 한다."""
import fcntl, os, pty, select, signal, struct, sys, termios, tty

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip()); sys.exit(2)
host = sys.argv[1]
cmd = ["mosh", "--server=/opt/homebrew/bin/mosh-server", host, "--",
       "/opt/homebrew/bin/tmux", "-u", "-L", "cchat", "attach"]  # brew가 /usr/local이면 두 경로를 고친다

ON, FIX = b"\x1b[?1003h", b"\x1b[?1002h\x1b[?1003h"
pid, fd = pty.fork()
if pid == 0:
    os.execvp(cmd[0], cmd)


def resize(*_):
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
        os.kill(pid, signal.SIGWINCH)
    except OSError:
        pass


resize()
signal.signal(signal.SIGWINCH, resize)
old = termios.tcgetattr(0)
tty.setraw(0)
tail = b""
try:
    while True:
        try:
            r, _, _ = select.select([0, fd], [], [])
        except InterruptedError:
            continue
        if 0 in r:
            d = os.read(0, 4096)
            if not d:
                break
            os.write(fd, d)
        if fd in r:
            try:
                d = os.read(fd, 65536)
            except OSError:
                break
            if not d:
                break
            d = (tail + d).replace(ON, FIX)
            # 다음 조각과 이어질 수 있는 끝부분(1003h의 앞부분)은 남겨 둔다
            keep = next((k for k in range(len(ON) - 1, 0, -1) if d.endswith(ON[:k])), 0)
            tail, d = (d[-keep:], d[:-keep]) if keep else (b"", d)
            os.write(1, d)
finally:
    if tail:
        os.write(1, tail)
    termios.tcsetattr(0, termios.TCSADRAIN, old)
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass
