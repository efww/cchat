#!/bin/zsh
# 탭 줄의 대화 탭을 눌렀을 때. tmux.conf의 MouseDown1Status(누름)·MouseUp1Status(손 뗌) 바인딩이 부른다.
#   cchat-tabtap <클라이언트> <탭>      누름: 그 대화로 이동(다른 탭의 닫기 대기는 풀림)
#   cchat-tabtap <클라이언트> <탭> up   손 뗌: 같은 탭을 0.45초 안에 두 번 → 바로 빨간 탭(닫기 대기 5초),
#                                        빨간 탭을 한 번 더 → 그 대화에 /exit
# tmux의 DoubleClick은 세 번째 누름을 기다리느라 0.4초쯤 늦게 와서 쓰지 않는다. 손 뗌은 바로 온다.
zmodload zsh/datetime
T=(@@BREW@@/tmux -L @@TMUX_SOCKET@@)
client=${1:-} r=${2:-} kind=${3:-}
[[ -n "$client" && -n "$r" ]] || exit 0
armed=$($T show -gqv @cchat_close)

if [[ "$kind" != up ]]; then
  [[ -n "$armed" && "$armed" != "$r" ]] && { $T set -gu @cchat_close; $T set -gu @cchat_close_t; $T refresh-client -S; }
  $T switch-client -c "$client" -t "=$r:"
  exit 0
fi

now=$EPOCHREALTIME
if [[ "$armed" == "$r" ]]; then
  # 빨간 탭을 한 번 더 → 닫기
  $T set -gu @cchat_close; $T set -gu @cchat_close_t; $T set -gu @cchat_up
  if [[ -n "$($T show -t "=$r:" -qv @busy)" ]]; then
    $T refresh-client -S; exit 0   # 작업 중인 탭은 닫지 않는다(빨간색만 풀림)
  fi
  pp=$($T display -p -t "=$r:" '#{pane_pid}')
  if pgrep -P "$pp" claude >/dev/null 2>&1; then
    $T send-keys -t "=$r:" C-u
    $T send-keys -t "=$r:" -l /exit
    $T send-keys -t "=$r:" Enter
    # /exit가 안 먹으면(대화상자 등) 8초 뒤 그 탭만 닫는다
    ( sleep 8; $T has -t "=$r" 2>/dev/null && $T kill-session -t "=$r" ) </dev/null >/dev/null 2>&1 &!
  else
    $T kill-session -t "=$r"
  fi
  $T refresh-client -S; exit 0
fi

prev=$($T show -gqv @cchat_up)   # "<탭> <시각>"
if [[ "${prev% *}" == "$r" ]] && (( now - ${prev##* } < 0.45 )); then
  $T set -gu @cchat_up
  $T set -g @cchat_close "$r"; $T set -g @cchat_close_t "$now"
  $T refresh-client -S
  ( sleep 5; [[ "$($T show -gqv @cchat_close_t)" == "$now" ]] && { $T set -gu @cchat_close; $T set -gu @cchat_close_t; $T refresh-client -S; } ) </dev/null >/dev/null 2>&1 &!
else
  $T set -g @cchat_up "$r $now"
fi
exit 0
