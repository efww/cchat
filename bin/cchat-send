#!/bin/zsh
# 한 대화의 마지막 답을 다른 대화의 입력칸에 붙여 넣는다(보내지는 않음 — 확인하고 Enter).
#   cchat-send <보낼 대화> <받을 대화> [앞에 붙일 말]
#   예: cchat-send 1 2 "이 조사 결과대로 구현해줘:"   (claude에게 "1번 결과를 2번에 넘겨"라고 해도 이걸 쓴다)
T=(@@BREW@@/tmux -L @@TMUX_SOCKET@@)
from=${1:-} to=${2:-} pre=${3:-}
[[ -n "$from" && -n "$to" ]] || { sed -n '2,4p' $0 | sed 's/^# \{0,1\}//'; exit 2; }
[[ "$from" == 0 ]] && from=main; [[ "$to" == 0 ]] && to=main
$T has -t "=$from" 2>/dev/null || { print -u2 "대화 $from 이 없습니다"; exit 1; }
$T has -t "=$to" 2>/dev/null || { print -u2 "대화 $to 이 없습니다"; exit 1; }
# 마지막 답 = 화면(+스크롤 300줄)에서 마지막 "● "로 시작하는 줄부터 claude 입력칸(─── 줄) 앞까지
ans=$($T capture-pane -p -J -S -300 -t "=$from:" | /usr/bin/python3 -I -c '
import re, sys
L = sys.stdin.read().splitlines()
start = max((i for i, l in enumerate(L) if l.startswith("● ")), default=None)
if start is None: sys.exit(1)
out = []
for l in L[start:]:
    if re.fullmatch(r"\s*─{10,}\s*", l): break
    out.append(l)
text = "\n".join(out).rstrip()
text = re.sub(r"^● ", "", text)
print(text)') || { print -u2 "대화 $from 에서 답(● 로 시작하는 줄)을 찾지 못했습니다"; exit 1; }
buf=cchat-send-$$
print -rn -- "${pre:+$pre
}$ans" | $T load-buffer -b $buf -
$T paste-buffer -p -d -b $buf -t "=$to:"   # -p: 붙여넣기로 보내 줄바꿈이 Enter로 처리되지 않게
print "대화 $from 의 마지막 답($(print -r -- "$ans" | wc -l | tr -d ' ')줄)을 대화 $to 입력칸에 넣었습니다(보내기 전)."
