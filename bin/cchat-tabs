#!/usr/bin/python3 -I
"""cchat 상태줄 대화 탭(config/tmux.conf의 status-left가 #()로 부른다).

  cchat-tabs render <client> <width> <지금대화> "<이름[+] 이름[+] ...>" <gen> [text|pad]
      맨 아래 줄 전체를 대화 탭으로 그린다. 이름 뒤 +done은 답이 끝났는데 안 본 대화(녹색), +ask는 허락을 기다리는 대화(주황), +busy는 작업 중(깜빡임). 값은 세션 옵션 @unread.
      다 들어가면 줄 폭을 나눠 쓰고, 넘치면 탭은 최소폭(이름+양옆 한 칸)으로 줄고 양 끝에 ◀ ▶.
      ◀ ▶는 보이는 범위만 민다(대화는 안 바뀜). 범위는 클라이언트별로 @@HOME@@/.cache/cchat-tabs/ 에 둔다.
      <gen>은 화면 갱신용 숫자(범위를 밀 때 올려서 tmux가 다시 그리게 한다).
      상태줄이 2줄이라 탭 하나가 두 줄 높이다: text = 위 줄(번호·화살표, 왼쪽 정렬), pad = 아래 줄(대화 이름표).
      이름표는 claude 상태줄 스크립트(~/.claude/statusline-command.sh)가 @@HOME@@/.cache/cchat-tablabel/<세션>에 남긴 것,
      없으면 claude가 붙인 대화 제목(pane_title).
      탭 폭보다 길면 앞에서부터 들어가는 만큼 넣고 탭 마지막 칸을 …로 끝낸다(한글은 두 칸으로 센다).
  cchat-tabs click <client> <_prev|_next>
      ◀ ▶ 클릭 처리(MouseDown1Status 바인딩).
  cchat-tabs go <client> <prev|next|attention|번호>
      PC 단축키(Alt+←/→, Alt+숫자, Alt+A): 탭 순서로 이전/다음 대화(끝에서 돌아감), 그 번호 대화(0=main),
      attention = 확인할 대화(주황 먼저, 없으면 녹색). 폰 키 바의 ★도 Alt+A를 보낸다.
  cchat-tabs apply
      cchat-set tab rows N 값에 맞춰 tmux 상태줄 줄 수를 바꾼다(1 → 2줄 높이 탭, 2~5 → 한 줄짜리 탭을 N줄에 배치).
  cchat-tabs click <client> _new
      맨 끝 + 칸: 빈 번호로 새 대화를 만들어 옮긴다. 넘쳐서 ◀ ▶가 생기면 그 뒤에 숨은 확인할 대화 수를 화살표 색·숫자로 보여 준다.
"""
import glob
import json
import os
import subprocess
import sys
import time
import unicodedata

TMUX = ["@@BREW@@/tmux", "-L", "@@TMUX_SOCKET@@"]
STATE = os.path.expanduser("@@HOME@@/.cache/cchat-tabs")
GAP = 1
ARROW_W = 3  # " ◀ "
PLUS_W = 3   # " + " 새 대화 칸(맨 끝)
WORKDIR = "@@WORKDIR@@"

# 탭 색은 전용 256색 번호(colour60~70)로 칠하고, 실제 색은 브라우저 테마(cchat-build-index의 TAB_COLORS)가
# 라이트·다크마다 따로 정한다(PC와 폰이 같은 탭 줄을 보므로 tmux 쪽엔 번호만 둔다).
def _c(bg, fg, bold=False):
    return f"#[bg=colour{bg},fg=colour{fg}{',bold' if bold else ''}]"
CUR = _c(69, 70, True)    # 지금 보는 탭: 진한 먹색(다크는 밝은 탭)
DONE = _c(62, 63, True)   # 답 끝남: 옅은 초록 바탕 + 초록 글자
ASK = _c(64, 65, True)    # 확인 필요: 옅은 호박색 바탕 + 진한 호박 글자
OTHER = _c(60, 61)
# 작업 중 탭: 겉모습은 OTHER와 같고, 빈칸의 글자색만 표시용 색 번호(BUSY_MARK)로 칠한다(빈칸이라 안 보임).
# 브라우저(cchat-build-index의 scanBusy)가 탭 위 줄에서 이 색의 빈칸을 찾아 번호 옆에 도는 기호(스피너)를 얹는다.
BUSY_MARK = 123
# 오래 안 쓴 탭(마지막 작업 뒤 1시간·6시간 넘음)은 글자를 흐리게, 6시간이면 바탕도 화면 쪽으로 물러나게.
IDLE_1H = _c(60, 66)
IDLE_6H = _c(67, 68)
ARROW_ON = _c(60, 61, True)
ARROW_OFF = _c(60, 66)
PLAIN = "#[default]"


def state_path(client):
    return os.path.join(STATE, client.strip("/").replace("/", "_") or "none")


def read_ofs(client):
    try:
        with open(state_path(client)) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def write_ofs(client, ofs):
    os.makedirs(STATE, exist_ok=True)
    with open(state_path(client), "w") as f:
        f.write(str(ofs))


# 기본 대화 main은 탭에 0으로 보이고 맨 앞에 온다(세션 이름은 main 그대로: ?arg 없이 접속하면 main).
LABELS = {"main": "0"}


def label(name):
    return LABELS.get(name, name)


def order(tabs):
    """숫자 작은 순(main=0이 맨 앞, 11은 7 뒤), 숫자가 아닌 이름은 그 뒤에 이름순."""
    def key(t):
        lab = label(t[0])
        return (0, int(lab), "") if lab.isdigit() else (1, 0, lab)
    return sorted(tabs, key=key)


def parse(names_arg):
    tabs = []
    for tok in names_arg.split():
        name, _, mark = tok.partition("+")
        tabs.append((name, mark))
    return order(tabs)


TAB_W = 4  # 넘칠 때 탭 고정폭: 두 자리 번호 + 양옆 한 칸. 이보다 긴 이름만 자기 길이+2


def minw(name):
    return max(TAB_W, len(label(name)) + 2)


def spread(widths, extra):
    """남는 칸을 앞에서부터 한 칸씩 나눠 준다."""
    i = 0
    while extra > 0 and widths:
        widths[i % len(widths)] += 1
        extra -= 1
        i += 1
    return widths


def fit_all(tabs, width):
    """다 들어가면 폭을 나눈 탭 폭 목록, 안 들어가면 None."""
    n = len(tabs)
    mins = [minw(t[0]) for t in tabs]
    if sum(mins) + GAP * (n - 1) > width:
        return None
    # 똑같이 나누되, 이름이 길어 나눈 폭보다 큰 탭은 자기 최소폭을 쓰고 나머지끼리 다시 나눈다.
    fixed = {}
    while True:
        free = [i for i in range(n) if i not in fixed]
        avail = width - GAP * (n - 1) - sum(fixed.values())
        share = avail // len(free)
        big = [i for i in free if mins[i] > share]
        if not big:
            break
        for i in big:
            fixed[i] = mins[i]
    widths = [fixed.get(i, share) for i in range(n)]
    return widths  # 나눈 나머지 칸은 오른쪽 끝 빈칸(탭 폭을 1칸씩 다르게 하지 않는다)


def visible_from(tabs, ofs, area):
    """ofs부터 area 안에 통째로 들어가는 탭 개수."""
    used, cnt = 0, 0
    for name, _ in tabs[ofs:]:
        need = minw(name) + (GAP if cnt else 0)
        if used + need > area:
            break
        used += need
        cnt += 1
    return max(cnt, 1)


def max_ofs(tabs, area):
    for ofs in range(len(tabs)):
        if ofs + visible_from(tabs, ofs, area) >= len(tabs):
            return ofs
    return 0


PAD_LINE = False
LABEL_DIR = os.path.expanduser("@@HOME@@/.cache/cchat-tablabel")
MANUAL_LABEL_DIR = "@@HOME@@/.config/cchat/labels"


def cells(ch):
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def width_of(text):
    return sum(cells(c) for c in text)


_titles = None
HOST = os.uname().nodename.split(".")[0]


def pane_title(name):
    """claude가 붙인 대화 제목(터미널 제목). 앞의 상태 기호(✳, 스피너)는 떼고, 기본값 'Claude Code'는 없는 셈."""
    global _titles
    if _titles is None:
        _titles = {}
        for line in tmux("list-panes", "-a", "-F", "#{session_name}\t#{pane_title}").splitlines():
            sess, _, title = line.partition("\t")
            title = title.strip()
            if title and not title[0].isalnum():
                title = title[1:].strip()
            if title and title != "Claude Code" and title.split(".")[0] != HOST:  # tmux 기본 제목은 컴퓨터 이름
                _titles.setdefault(sess, title)
    return _titles.get(name, "")


def tab_label(name):
    """이름표: cchat-label로 직접 단 것(@@HOME@@/.config/cchat/labels) → claude 상태줄이 남긴 것 → claude가 붙인 대화 제목."""
    for d in (MANUAL_LABEL_DIR, LABEL_DIR):
        try:
            with open(os.path.join(d, name), encoding="utf-8") as f:
                lab = " ".join(f.read().split())
        except (OSError, ValueError):
            lab = ""
        if lab:
            return lab
    return pane_title(name)


def clip(text, room):
    """room 칸에 맞춘다. 넘치면 앞에서부터 room-1칸까지 넣고 마지막 칸은 …"""
    if width_of(text) <= room:
        return text
    out, used = "", 0
    for c in text:
        if used + cells(c) > room - 1:
            break
        out += c
        used += cells(c)
    return out + " " * (room - 1 - used) + "…"


_meta = None


def setting(key, default):
    """cchat-set이 쓰는 @@HOME@@/.config/cchat/settings(key=value)에서 값 하나."""
    try:
        for line in open(os.path.expanduser("@@HOME@@/.config/cchat/settings")):
            k, _, v = line.strip().partition("=")
            if k == key:
                return v
    except OSError:
        pass
    return default


def meta(name):
    """탭 아래 줄 끝 숫자: 작업 중이면 걸린 시간(3m), 아니면 대화 크기(42k). 한 번의 tmux 호출로 모든 대화 값을 읽는다."""
    global _meta
    if _meta is None:
        _meta = {}
        now = int(time.time())
        show_ctx = setting("tab.ctx", "on") == "on"
        for line in tmux("list-sessions", "-F", "#{session_name}\t#{@busy}\t#{@busy_since}\t#{@ctx}").splitlines():
            n, busy, since, ctx = (line.split("\t") + ["", "", "", ""])[:4]
            if busy and since.isdigit():
                el = max(0, now - int(since))
                _meta[n] = f"{el // 60}m" if el >= 60 else f"{el}s"
            elif ctx and show_ctx:
                _meta[n] = ctx
    return _meta.get(name, "")


def box(style, text, w, rng=None, busy=False):
    if PAD_LINE:
        text = ""
        if rng and not rng.startswith("_"):
            m, lab = meta(rng), tab_label(rng)
            if m and w - 1 >= len(m) + 4:  # 이름표 칸을 줄이고 끝에 숫자
                room = w - 1 - len(m) - 1
                text = clip(lab, room) if width_of(lab) > room else lab + " " * (room - width_of(lab))
                text += " " + m
            else:
                text = clip(lab, w - 1)
    pad = max(0, w - width_of(text))
    left = pad // 2 if not rng or rng.startswith("_") else min(1, pad)  # 탭 이름은 왼쪽 정렬(한 칸 띄움), 화살표는 가운데
    sp = (lambda n: f"#[fg=colour{BUSY_MARK}]{' ' * n}{style}") if busy and not PAD_LINE else (lambda n: " " * n)
    body = f"{style}{sp(left)}{text}{sp(pad - left)}"
    if rng:
        return f"#[range=user|{rng}]{body}#[norange]{PLAIN}"
    return body + PLAIN


def is_busy(name, mark, cur):
    return mark == "busy"  # 지금 보는 탭도 작업 중이면 스피너


_idle = None


def idle_secs(name):
    """마지막 작업 뒤 지난 초: claude 상태 파일(~/.claude/sessions/<pid>.json)의 상태가 마지막으로 바뀐 시각과
    cchat-unread가 남긴 @last_act 중 늦은 것. 둘 다 없으면 0(흐리게 안 함). tmux의 활동 시각은 화면 갱신으로 늘 최근이라 안 쓴다."""
    global _idle
    if _idle is None:
        last = {}
        for f in glob.glob(os.path.expanduser("@@HOME@@/.claude/sessions/*.json")):
            try:
                d = json.load(open(f))
                os.kill(int(d["pid"]), 0)
                n = str(d.get("tmux") or "").split(":")[0]
                t = int(d.get("statusUpdatedAt") or 0) // 1000
                if n and t:
                    last[n] = max(last.get(n, 0), t)
            except Exception:
                pass
        for line in tmux("list-sessions", "-F", "#{session_name}\t#{@last_act}").splitlines():
            n, la = (line.split("\t") + ["", ""])[:2]
            if la.isdigit():
                last[n] = max(last.get(n, 0), int(la))
        now = int(time.time())
        _idle = {n: now - t for n, t in last.items()}
    return _idle.get(name, 0)


def style_of(name, unread, cur):
    if name == cur:
        return CUR
    if unread == "busy":
        return OTHER
    if not unread:
        age = idle_secs(name)
        return IDLE_6H if age >= 6 * 3600 else IDLE_1H if age >= 3600 else OTHER
    return ASK if unread == "ask" else DONE


def plus_box():
    return box(ARROW_ON, "+", PLUS_W, "_new")


def hidden_style(hidden, cur):
    """◀ ▶ 뒤에 숨은 탭 중 확인할 것(주황 먼저, 없으면 녹색)과 그 개수."""
    ask = sum(1 for n, u in hidden if u == "ask" and n != cur)
    done = sum(1 for n, u in hidden if u == "done" and n != cur)
    if ask:
        return ASK, ask + done
    if done:
        return DONE, done
    return None, 0


def arrow(ch, hidden, cur, rng):
    st, cnt = hidden_style(hidden, cur)
    if st:
        return box(st, f"{ch}{cnt if cnt < 10 else '+'}", ARROW_W, rng)
    return box(ARROW_ON if hidden else ARROW_OFF, ch, ARROW_W, rng)


def render(client, width, cur, tabs):
    if not tabs:
        return ""
    width -= PLUS_W + GAP  # 맨 끝 + 칸 자리
    widths = fit_all(tabs, width)
    if widths is not None:
        parts = [box(style_of(n, u, cur), label(n), w, n, is_busy(n, u, cur)) for (n, u), w in zip(tabs, widths)]
        return (" " * GAP).join(parts) + " " * GAP + plus_box() + PLAIN

    area = width - 2 * (ARROW_W + GAP)
    top = max_ofs(tabs, area)
    ofs = read_ofs(client)
    if ofs is None:  # 처음 그릴 때는 지금 대화가 보이게
        names = [t[0] for t in tabs]
        ofs = 0
        if cur in names:
            ci = names.index(cur)
            while ofs < top and not (ofs <= ci < ofs + visible_from(tabs, ofs, area)):
                ofs += 1
    ofs = min(max(ofs, 0), top)
    cnt = visible_from(tabs, ofs, area)
    shown = tabs[ofs:ofs + cnt]
    ws = [minw(n) for n, _ in shown]  # 고정폭 그대로(남는 칸은 ▶ 앞 빈칸)
    rest = max(0, area - sum(ws) - GAP * (len(ws) - 1))
    left = arrow("◀", tabs[:ofs], cur, "_prev")
    right = arrow("▶", tabs[ofs + cnt:], cur, "_next")
    mid = (" " * GAP).join(box(style_of(n, u, cur), label(n), w, n, is_busy(n, u, cur)) for (n, u), w in zip(shown, ws))
    return f"{left}{' ' * GAP}{mid}{' ' * (GAP + rest)}{right}{' ' * GAP}{plus_box()}"


def tab_rows():
    """cchat-set tab rows N: 1 = 탭 하나가 2줄 높이(번호/이름)인 한 줄 탭, 2~5 = 한 줄짜리 탭을 N줄에 나눠 배치."""
    v = setting("tab.rows", "1")
    return min(5, max(1, int(v))) if v.isdigit() else 1


def status_lines():
    rows = tab_rows()
    return 2 if rows <= 1 else rows


def row_box(name, unread, cur, w):
    """여러 줄 모드의 한 줄짜리 탭: ' 번호 이름표 … 42k ◌' (◌ = 맨 오른쪽 칸, 작업 중 스피너 자리. 브라우저가 그림)."""
    lab = label(name)
    head = lab + " "
    room = w - 3 - width_of(head)  # 왼쪽 한 칸 + 오른쪽 스피너 칸과 그 앞 한 칸
    if room < 2:
        text = clip(lab, max(1, w - 3))
    else:
        title, m = tab_label(name), meta(name)
        if m and room >= len(m) + 4:
            r = room - len(m) - 1
            t = clip(title, r)
            text = head + t + " " * (r - width_of(t)) + " " + m
        else:
            text = head + clip(title, room)
    return box(style_of(name, unread, cur), text, w, name, is_busy(name, unread, cur))


def render_rows(width, cur, tabs, rows, line):
    """여러 줄 모드: 탭을 앞에서부터 줄마다 같은 개수씩 채운다(칸 폭이 같아 위아래 줄이 맞는다). + 는 마지막 줄 끝."""
    k = max(1, -(-len(tabs) // rows))  # 한 줄 탭 수
    avail = width - PLUS_W - GAP
    share = max(TAB_W, (avail - GAP * (k - 1)) // k)
    chunk = tabs[line * k:(line + 1) * k]
    out = (" " * GAP).join(row_box(n, u, cur, share) for n, u in chunk)
    if line == rows - 1:
        used = len(chunk) * share + GAP * max(0, len(chunk) - 1)
        out += " " * max(GAP, avail - used + GAP) + plus_box()
    return out + PLAIN


def apply_rows():
    """설정한 탭 줄 수에 맞게 tmux 상태줄 줄 수를 바꾼다(cchat-set tab rows, tmux 시작 때)."""
    tmux("set", "-g", "status", str(status_lines()))
    gen = tmux("show", "-gv", "@cchat_tabgen") or "0"
    tmux("set", "-g", "@cchat_tabgen", str(int(gen) + 1 if gen.isdigit() else 1))


def tmux(*args):
    return subprocess.run(TMUX + list(args), capture_output=True, text=True).stdout.strip()


def new(client):
    """+ 칸: 비어 있는 가장 작은 번호(1부터)로 새 대화를 만들고 그리로 옮긴다."""
    used = {label(n) for n, _ in parse(tmux("list-sessions", "-F", "#{session_name}"))}
    n = 1
    while str(n) in used:
        n += 1
    tmux("new-session", "-d", "-s", str(n), "-c", WORKDIR, "@@HOME@@/.local/bin/cchat-session --loop")
    tmux("switch-client", "-c", client, "-t", f"={n}:")


def click(client, which):
    if which == "_new":
        return new(client)
    width = int(tmux("display", "-p", "-c", client, "#{client_width}") or 80) - PLUS_W - GAP
    cur = tmux("display", "-p", "-c", client, "#{client_session}")
    tabs = parse(tmux("list-sessions", "-F", "#{session_name}"))
    if fit_all(tabs, width) is not None:
        return
    area = width - 2 * (ARROW_W + GAP)
    top = max_ofs(tabs, area)
    ofs = read_ofs(client)
    if ofs is None:
        ofs = 0
        names = [t[0] for t in tabs]
        if cur in names:
            ci = names.index(cur)
            while ofs < top and not (ofs <= ci < ofs + visible_from(tabs, ofs, area)):
                ofs += 1
    ofs = min(max(ofs + (1 if which == "_next" else -1), 0), top)
    write_ofs(client, ofs)
    gen = tmux("show", "-gv", "@cchat_tabgen") or "0"
    tmux("set", "-g", "@cchat_tabgen", str(int(gen) + 1 if gen.isdigit() else 1))
    tmux("refresh-client", "-t", client, "-S")


def go(client, which):
    cur = tmux("display", "-p", "-c", client, "#{client_session}")
    names = [n for n, _ in parse(tmux("list-sessions", "-F", "#{session_name}"))]
    if not names:
        return
    if which == "attention":
        # ★ / Alt+A: 주황(확인 필요) 대화부터, 없으면 녹색(끝남). 지금 대화 다음부터 탭 순서로 돈다.
        tabs = parse(tmux("list-sessions", "-F", "#{session_name}#{?#{@unread},+#{@unread},}"))
        i = names.index(cur) if cur in names else -1
        ring = tabs[i + 1:] + tabs[:i + 1]
        target = next((n for n, u in ring if u == "ask" and n != cur), None) \
            or next((n for n, u in ring if u == "done" and n != cur), None)
        if target is None:
            tmux("display-message", "-c", client, "확인할 대화가 없습니다")
            return
    elif which in ("prev", "next"):
        i = names.index(cur) if cur in names else 0
        target = names[(i + (1 if which == "next" else -1)) % len(names)]
    else:
        target = next((n for n in names if label(n) == which), None)
        if target is None:
            return
    if target == cur:
        return
    try:  # 탭이 넘칠 때 새 대화가 보이게 범위를 다시 잡는다
        os.remove(state_path(client))
    except OSError:
        pass
    tmux("switch-client", "-c", client, "-t", f"={target}:")


def main(argv):
    global PAD_LINE
    if len(argv) >= 5 and argv[0] == "render":
        # 줄 인자: l0~l4(status-format[0~4]). 예전 text/pad도 받는다.
        which = argv[6] if len(argv) >= 7 else "l0"
        line = {"text": 0, "pad": 1}.get(which, int(which[1:]) if which[1:].isdigit() else 0)
        client, width, cur, names = argv[1], int(argv[2] or 80), argv[3], argv[4]
        rows = tab_rows()
        if rows <= 1:
            if line > 1:
                print("")
                return 0
            PAD_LINE = line == 1
            print(render(client, width, cur, parse(names)))
        else:
            print(render_rows(width, cur, parse(names), rows, line) if line < rows else "")
    elif argv[:1] == ["apply"]:
        apply_rows()
    elif len(argv) == 3 and argv[0] == "go":
        go(argv[1], argv[2])
    elif len(argv) == 3 and argv[0] == "click":
        click(argv[1], argv[2])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
