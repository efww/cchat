#!/usr/bin/env python3
"""cchat: ttyd 기본 index.html에 cchat 전용 부분을 넣어 @@HOME@@/.config/cchat/index.html을 만든다.

- 모바일 viewport (폰에서 글자가 작게 축소되던 문제)
- 기기별 터미널 색: PC=라이트, 폰(터치 또는 좁은 화면)=다크
  claude는 16색 전용 테마(light-ansi)로 돌고, 16색 팔레트만 기기별로 다르다.
  폰 팔레트는 light-ansi 의미(black=글자, white=옅은 바탕)를 뒤집어 다크로 보이게 한다.
- 폰 하단 키 버튼: Esc, Shift+Tab, Tab, 방향키, Ctrl+C, Enter
- 폰 손가락 드래그 → 마우스 휠 신호(위 대화로 스크롤)

ttyd를 업그레이드(brew upgrade ttyd)한 뒤에는 이 스크립트를 다시 실행하고
launchctl kickstart -k gui/$(id -u)/@@LAUNCHD_PREFIX@@.ttyd 로 ttyd를 다시 띄운다.
"""
import json
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

TTYD = "@@BREW@@/ttyd"
OUT = Path("@@HOME@@/.config/cchat/index.html")
STAMP = Path("@@HOME@@/.config/cchat/index.ttyd-version")
SETTINGS = Path("@@HOME@@/.config/cchat/settings")
SNIPS = Path("@@HOME@@/.config/cchat/snippets")  # cchat-snip  # cchat-set이 쓰는 key=value


def setting(key: str, default: str) -> str:
    try:
        for line in SETTINGS.read_text(encoding="utf-8").splitlines():
            k, _, v = line.partition("=")
            if k.strip() == key and v.strip():
                return v.strip()
    except OSError:
        pass
    return default


def font_px(key: str) -> int:
    v = setting(key, "off")
    return int(v) if v.isdigit() and 8 <= int(v) <= 32 else 0

LIGHT = {
    "background": "#fbfbfd", "foreground": "#1f2328", "cursor": "#1f2328", "cursorAccent": "#fbfbfd",
    "selectionBackground": "#b4d5fe",
    "black": "#24292f", "red": "#cf222e", "green": "#116329", "yellow": "#4d2d00",
    "blue": "#0969da", "magenta": "#8250df", "cyan": "#1b7c83", "white": "#e6e8eb",
    "brightBlack": "#6e7781", "brightRed": "#a40e26", "brightGreen": "#1a7f37", "brightYellow": "#633c01",
    "brightBlue": "#218bff", "brightMagenta": "#a475f9", "brightCyan": "#3192aa", "brightWhite": "#f6f8fa",
}
DARK = {
    "background": "#0d1117", "foreground": "#e6edf3", "cursor": "#e6edf3", "cursorAccent": "#0d1117",
    "selectionBackground": "#264f78",
    "black": "#e6edf3", "red": "#ff7b72", "green": "#3fb950", "yellow": "#d29922",
    "blue": "#58a6ff", "magenta": "#bc8cff", "cyan": "#39c5cf", "white": "#2d333b",
    "brightBlack": "#8b949e", "brightRed": "#ffa198", "brightGreen": "#56d364", "brightYellow": "#e3b341",
    "brightBlue": "#79c0ff", "brightMagenta": "#d2a8ff", "brightCyan": "#56d4dd", "brightWhite": "#22272e",
}


def dark_extended_ansi() -> list:
    """256색 16~255번을 다크용으로. claude(light-ansi)는 코드·도구 출력에 회색 단계(232~255)와
    16(검정)/231(흰색)을 밝은 바탕 기준으로 쓴다. 다크에서는 밝기를 뒤집되, 중간 회색은
    조금 더 밝게(지수 0.75) 올려 검은 바탕에서도 읽히게 한다. 나머지 색상 큐브는 그대로."""
    def hexc(v):
        return "#%02x%02x%02x" % v
    levels = [0, 95, 135, 175, 215, 255]
    out = []
    for i in range(16, 256):
        if i == 16:
            out.append(DARK["foreground"])
        elif i == 231:
            out.append(DARK["background"])
        elif i < 232:
            n = i - 16
            out.append(hexc((levels[n // 36], levels[(n // 6) % 6], levels[n % 6])))
        else:
            v = 8 + 10 * (i - 232)
            inv = 1 - (v - 8) / 230
            g = round(13 + 225 * inv ** 0.75)
            out.append(hexc((g, g, g)))
    return out


# 탭 줄 전용 색(cchat-tabs가 colour60~70으로 칠함). 무채색 바탕 위에 옅은 색조 바탕+같은 계열 진한 글자로
# 상태를 구분한다(완료=초록, 확인 필요=호박색). 작업 중 탭 번호 옆 스피너는 그 탭 글자색.
TAB_COLORS = {
    "light": {60: "#eceef1", 61: "#3d444d", 62: "#d3f0dc", 63: "#116329", 64: "#fde4c4", 65: "#8a4600",
              66: "#8c959f", 67: "#f6f8fa", 68: "#afb8c1", 69: "#24292f", 70: "#ffffff"},
    "dark": {60: "#272e37", 61: "#c9d1d9", 62: "#173b26", 63: "#6bdc84", 64: "#45300f", 65: "#f2b35c",
             66: "#7d8590", 67: "#161b22", 68: "#545d68", 69: "#e6edf3", 70: "#0d1117"},
}


def base_extended_ansi() -> list:
    """xterm 기본 256색의 16~255번."""
    levels = [0, 95, 135, 175, 215, 255]
    out = []
    for i in range(16, 256):
        if i < 232:
            n = i - 16
            out.append("#%02x%02x%02x" % (levels[n // 36], levels[(n // 6) % 6], levels[n % 6]))
        else:
            v = 8 + 10 * (i - 232)
            out.append("#%02x%02x%02x" % (v, v, v))
    return out


def with_tab_colors(ext: list, name: str) -> list:
    ext = list(ext)
    for i, c in TAB_COLORS[name].items():
        ext[i - 16] = c
    return ext


DARK["extendedAnsi"] = with_tab_colors(dark_extended_ansi(), "dark")
LIGHT["extendedAnsi"] = with_tab_colors(base_extended_ansi(), "light")
# 폰 키 바. ★ = Alt+A(확인할 대화로), ⋯ = 아래 MORE 줄 열기/닫기. "@이름"은 페이지가 처리하는 동작.
KEYS = [["★", "\u001ba"], ["Esc", "\u001b"], ["⇧Tab", "\u001b[Z"], ["Tab", "\t"], ["↑", "\u001b[A"],
        ["↓", "\u001b[B"], ["^C", "\u0003"], ["⇧⏎", "\u001b\r"], ["⏎", "\r"], ["⋯", "@more"]]
# ⋯ 줄: ☰ = Alt+L(Claude 세션 목록, cchat-ls), 🎤 음성 입력, ✎ 자주 쓰는 지시문(cchat-snip), 📎 사진·파일(원격 중계가 있을 때만)
MORE = [["☰", "\u001bl"], ["←", "\u001b[D"], ["→", "\u001b[C"], ["🎤", "@voice"], ["✎", "@snip"], ["📎", "@attach"]]

# 홈 화면 앱(PWA): 원격 중계가 ./manifest.json을 내줄 때만 설치 가능(이 맥 주소로 바로 열면 404, 무해)
MANIFEST = ('<link rel="manifest" href="./manifest.json">'
            '<meta name="theme-color" content="#0d1117"><meta name="mobile-web-app-capable" content="yes">')

VIEWPORT = ('<meta name="viewport" content="width=device-width, initial-scale=1, '
            'viewport-fit=cover, interactive-widget=resizes-content">')

STYLE = """<style id="cchat-style">
html,body{background:var(--cchat-bg,#fbfbfd)}
#cchat-keys{display:none}
html[data-cchat-device=mobile] #terminal-container{height:calc(100% - 48px - env(safe-area-inset-bottom));touch-action:none;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
html[data-cchat-device=mobile] #cchat-keys{display:flex;position:fixed;left:0;right:0;bottom:0;gap:4px;
  height:calc(48px + env(safe-area-inset-bottom));padding:5px 4px calc(5px + env(safe-area-inset-bottom));
  box-sizing:border-box;background:#161b22;border-top:1px solid #30363d;z-index:10;
  user-select:none;-webkit-user-select:none;touch-action:manipulation}
#cchat-more{display:none;position:fixed;left:0;right:0;bottom:calc(48px + env(safe-area-inset-bottom));gap:4px;padding:5px 4px;
  box-sizing:border-box;background:#161b22;border-top:1px solid #30363d;z-index:11;height:44px}
#cchat-more.on{display:flex}
html.cchat-more-on[data-cchat-device=mobile] #terminal-container{height:calc(100% - 92px - env(safe-area-inset-bottom))}
#cchat-keys .k.on{background:#30363d}
#cchat-more .k.on{background:#1f6feb}
#cchat-pop{position:fixed;left:8px;right:8px;bottom:calc(96px + env(safe-area-inset-bottom));z-index:13;max-height:45vh;overflow:auto;
  background:#22272e;border:1px solid #444c56;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,.4)}
#cchat-pop .pi{padding:12px 14px;color:#e6edf3;font:500 14px/1.35 system-ui,sans-serif;border-bottom:1px solid #30363d}
#cchat-keys .k,#cchat-more .k{flex:1;display:flex;align-items:center;justify-content:center;border-radius:6px;
  background:#21262d;color:#e6edf3;border:1px solid #30363d;font:600 14px/1 -apple-system,system-ui,sans-serif}
#cchat-keys .k:active,#cchat-more .k:active{background:#388bfd;color:#fff}
</style>"""

SCRIPT = """<script id="cchat-script">
(() => {
  const LIGHT = __LIGHT__, DARK = __DARK__, KEYS = __KEYS__, MORE = __MORE__, BUILD = '__BUILD__', SET = __SET__;
  const mq = (q) => { try { return matchMedia(q).matches; } catch (_) { return false; } };
  const coarse = mq('(pointer: coarse)');
  const mobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '') || coarse
    || mq('(hover: none)') || Math.min(screen.width || 9999, innerWidth || 9999) <= 600;
  // 테마: cchat-set theme pc|phone light|dark (기본 PC=라이트, 폰=다크)
  const dark = (mobile ? SET.themePhone : SET.themePc) === 'dark';
  const theme = dark ? DARK : LIGHT;
  const root = document.documentElement;
  root.dataset.cchatDevice = mobile ? 'mobile' : 'desktop';
  root.style.setProperty('--cchat-bg', theme.background);

  // 판별 결과를 ttyd 로그에 남긴다(404 경로 /cchat/__cchat/...). 실제 기기 확인용.
  const beacon = (stage) => {
    try {
      const t = window.term && window.term.options && window.term.options.theme;
      const bg = ((t && t.background) || 'none').replace('#', '');
      fetch(`./__cchat/${stage}/${BUILD}/${mobile ? 'mobile' : 'desktop'}/${bg}/${innerWidth}x${innerHeight}/${coarse ? 'coarse' : 'fine'}`,
        { cache: 'no-store' }).catch(() => {});
    } catch (_) {}
  };

  // 연결이 끊기면 자동으로 다시 붙는다.
  // ttyd는 정상 종료(코드 1000)나 소켓 오류 뒤에 "Press ⏎ to Reconnect"만 띄우고, 실제 키보드 Enter(onKey의 domEvent)만 받는다.
  // 폰 화면 키보드 Enter는 key가 'Enter'로 안 오고, 키 바 버튼은 term.input(onData)이라 그 감지에 걸리지 않아 새로고침밖에 없었다.
  // 그래서 소켓을 추적하다가 끊기면 xterm의 onKey에 Enter를 직접 흘려 ttyd 재연결을 부르고, 6초 안에 안 붙으면 새로고침한다.
  let sock = null, tries = 0, openedAt = 0, autoTimer = null, fallback = null;
  // 지금 보는 대화: tmux가 터미널 제목을 'cchat:<대화>'로 보낸다(config/tmux.conf set-titles).
  // ttyd는 접속 주소(?arg=)를 페이지를 열 때 한 번만 정해서, 탭으로 대화를 바꾼 뒤 다시 붙으면
  // 주소창의 대화로 돌아가 버렸다 → 다시 붙을 때 소켓 주소의 arg를 지금 대화로 바꾸고, 주소창도 맞춰 둔다.
  let curSession = null;
  const withSession = (url) => {
    if (!curSession) return url;
    try { const u = new URL(url, location.href); u.searchParams.set('arg', curSession); return u.toString(); } catch (_) { return url; }
  };
  const installTitle = (term) => {
    if (term.__cchatTitle || !term.onTitleChange) return;
    term.__cchatTitle = true;
    term.onTitleChange((t) => {
      const m = /^cchat:([A-Za-z0-9][A-Za-z0-9_-]{0,31})$/.exec(t || '');
      if (!m) return;
      curSession = m[1];
      try { history.replaceState(history.state, '', withSession(location.href)); } catch (_) {}
      document.title = `cchat ${curSession === 'main' ? '0' : curSession}`;
    });
  };
  const NativeWS = window.WebSocket;
  const PatchedWS = function (...args) {
    if (typeof args[0] === 'string') args[0] = withSession(args[0]);
    const ws = new NativeWS(...args);
    sock = ws;
    ws.addEventListener('open', () => { openedAt = Date.now(); clearTimeout(fallback); clearTimeout(waitTimer); waitTimer = null; waitStep = 0; downBar(''); });
    ws.addEventListener('close', () => {
      if (sock !== ws) return;
      tries = Date.now() - openedAt > 10000 ? 1 : tries + 1;  // 금방 또 끊기면 간격을 늘린다(최대 30초, 멈추지 않음)
      clearTimeout(autoTimer);
      if (document.visibilityState === 'visible') autoTimer = setTimeout(() => reconnect('auto'), Math.min(1500 * tries, 30000));
    });
    return ws;
  };
  PatchedWS.prototype = NativeWS.prototype;
  Object.assign(PatchedWS, { CONNECTING: 0, OPEN: 1, CLOSING: 2, CLOSED: 3 });
  window.WebSocket = PatchedWS;
  const isDown = () => !!sock && sock.readyState >= 2;
  const reconnect = (why) => {
    if (!isDown()) return;
    clearTimeout(autoTimer); clearTimeout(fallback);
    beacon(`reconnect-${why}-${tries}`);
    try {
      const em = window.term && window.term._core && window.term._core._onKey;
      if (em && em.fire) em.fire({ key: '\\r', domEvent: new KeyboardEvent('keydown', { key: 'Enter' }) });
    } catch (_) {}
    fallback = setTimeout(() => { if (isDown()) waitAndReload(); }, 6000);
  };
  // 6초 안에 안 붙으면: 서버가 정말 cchat 페이지를 내줄 때만 새로고침한다.
  // 맥이 잠들었거나 통로가 끊긴 동안 바로 새로고침하면 프록시 오류 페이지로 넘어가 재연결 코드가 사라졌다.
  // 그 동안은 위에 작은 띠를 띄우고 2→30초 간격으로 다시 확인한다(띠를 누르면 바로 새로고침).
  let waitTimer = null, waitStep = 0;
  const WAIT = [2, 3, 5, 10, 20, 30];
  const downBar = (text) => {
    let el = document.getElementById('cchat-down');
    if (!text) { if (el) el.remove(); return; }
    if (!el) {
      el = document.createElement('div');
      el.id = 'cchat-down';
      el.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:30;padding:6px 10px;text-align:center;cursor:pointer;'
        + 'font:600 13px/1.3 system-ui,sans-serif;background:#9a6700;color:#fff';
      el.onclick = () => location.reload();
      document.body.appendChild(el);
    }
    el.textContent = text;
  };
  const serverUp = async () => {
    try {
      const r = await fetch(location.href, { cache: 'no-store', credentials: 'same-origin' });
      return r.ok && (await r.text()).includes('cchat-script');
    } catch (_) { return false; }
  };
  const waitAndReload = async () => {
    clearTimeout(waitTimer);
    if (!isDown()) { waitStep = 0; downBar(''); return; }
    if (await serverUp()) { location.reload(); return; }
    const s = WAIT[Math.min(waitStep++, WAIT.length - 1)];
    downBar(`연결 끊김 — 맥이나 통로를 기다리는 중, ${s}초 뒤 다시 확인 (누르면 새로고침)`);
    waitTimer = setTimeout(waitAndReload, s * 1000);
  };
  window.__cchatWait = () => ({ down: isDown(), step: waitStep, bar: !!document.getElementById('cchat-down') });
  const onBack = () => {
    if (document.visibilityState === 'visible' && isDown()) { if (waitTimer) waitAndReload(); else reconnect('visible'); }
  };
  document.addEventListener('visibilitychange', onBack);
  window.addEventListener('pageshow', onBack);
  window.addEventListener('online', onBack);
  window.addEventListener('focus', onBack);

  const keyEl = (label, seq) => {
    const key = document.createElement('div');
    key.className = 'k';
    key.textContent = label;
    key.setAttribute('role', 'button');
    key.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      if (seq[0] === '@') return action(seq.slice(1), key);
      if (isDown()) { tries = 0; reconnect('button'); return; }  // 끊겨 있으면 어떤 버튼이든 재연결
      if (window.term) window.term.input(seq, true);
    });
    key.addEventListener('mousedown', (e) => e.preventDefault());
    key.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
    return key;
  };
  const buildKeys = () => {
    const bar = document.createElement('div');
    bar.id = 'cchat-keys';
    for (const [label, seq] of KEYS) bar.appendChild(keyEl(label, seq));
    const more = document.createElement('div');
    more.id = 'cchat-more';
    for (const [label, seq] of MORE) {
      if (seq === '@voice' && !(window.SpeechRecognition || window.webkitSpeechRecognition)) continue;
      const k = keyEl(label, seq);
      if (seq === '@attach') { k.id = 'cchat-attach'; k.style.display = 'none'; }
      more.appendChild(k);
    }
    document.body.appendChild(more);
    document.body.appendChild(bar);
    // 📎는 원격 중계가 업로드를 받을 때만 보인다
    fetch('./upload', { cache: 'no-store' }).then((r) => { if (r.status === 204) document.getElementById('cchat-attach').style.display = ''; }).catch(() => {});
    if (window.term && typeof window.term.fit === 'function') window.term.fit();
  };
  const popup = (items, onPick) => {  // 키 바 위에 뜨는 목록(지시문 등). 다시 누르거나 고르면 닫힘
    let el = document.getElementById('cchat-pop');
    if (el) { el.remove(); return; }
    el = document.createElement('div');
    el.id = 'cchat-pop';
    for (const it of items) {
      const b = document.createElement('div');
      b.className = 'pi'; b.textContent = it;
      b.addEventListener('pointerdown', (e) => { e.preventDefault(); el.remove(); onPick(it); });
      el.appendChild(b);
    }
    document.body.appendChild(el);
  };
  let rec = null;
  const action = (name, key) => {
    const term = window.term;
    if (name === 'more') {
      const m = document.getElementById('cchat-more');
      const on = !m.classList.contains('on');
      m.classList.toggle('on', on); key.classList.toggle('on', on);
      root.classList.toggle('cchat-more-on', on);  // 터미널을 한 줄 높이만큼 줄여 탭 줄이 가려지지 않게
      setTimeout(() => { try { term && term.fit && term.fit(); } catch (_) {} }, 30);
      const p = document.getElementById('cchat-pop'); if (p) p.remove();
    } else if (name === 'snip') {
      if (!SET.snips.length) { toast('지시문이 없습니다 — claude에게 "이 지시문 저장해 둬"'); return; }
      popup(SET.snips, (t) => term && term.input(t, true));  // 보내지는 않음(확인하고 ⏎)
    } else if (name === 'voice') {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (rec) { rec.stop(); return; }
      rec = new SR();
      rec.lang = navigator.language || 'ko-KR'; rec.interimResults = false; rec.maxAlternatives = 1;
      key.classList.add('on'); toast('듣는 중… 말을 마치면 입력칸에 들어갑니다');
      rec.onresult = (e) => { const t = e.results[0][0].transcript; if (t && term) term.input(t, true); };
      rec.onerror = (e) => toast('음성 입력 실패: ' + e.error);
      rec.onend = () => { rec = null; key.classList.remove('on'); };
      rec.start();
    } else if (name === 'attach') {
      const inp = document.createElement('input');
      inp.type = 'file'; inp.accept = 'image/*,application/pdf,text/*,*/*';
      inp.onchange = async () => {
        const f = inp.files && inp.files[0];
        if (!f) return;
        if (f.size > 20 * 1024 * 1024) { toast('20MB까지 올릴 수 있습니다'); return; }
        toast(`올리는 중… ${f.name}`);
        try {
          const r = await fetch('./upload', { method: 'POST', body: f, headers: { 'x-name': f.name.replace(/[^\\x20-\\x7e]/g, '_') } });
          if (!r.ok) throw new Error('HTTP ' + r.status);
          const { name } = await r.json();
          if (term) term.input('\\u001bu', true);  // Alt+U: 맥이 중계에서 파일을 가져온다(cchat-inbox)
          setTimeout(() => { if (term) term.input(`.cchat-inbox/${name} `, true); toast('맥으로 가져왔습니다 — 경로를 입력칸에 넣었어요'); }, 1500);
        } catch (e) { toast('올리기 실패: ' + e.message); }
      };
      inp.click();
    }
  };
  window.__cchatAction = action;

  // 폰: 손가락 위아래 드래그를 마우스 휠 신호(SGR)로 바꿔 보낸다.
  // xterm.js는 터치를 휠로 바꿔 주지 않아서 폰에서는 위 대화로 스크롤할 수 없었다.
  // 손가락을 아래로 끌면 휠 위(64) = 이전 대화, 위로 끌면 휠 아래(65). claude가 전체화면(마우스 사용)이라 tmux가 휠을 claude에 그대로 넘긴다.
  const STEP = 0.8;   // 손가락이 글자 줄 STEP개만큼 움직일 때마다 휠 한 칸(claude 전체화면은 한 칸에 약 1줄)
  const FIRST = 0.3;  // 드래그 첫 칸은 STEP의 이 비율만 움직여도 보낸다
  const installTouchScroll = () => {
    const el = document.getElementById('terminal-container');
    if (!el || el.dataset.cchatTouch) return;
    el.dataset.cchatTouch = '1';
    // 브라우저는 touchmove를 손가락이 ~16px 움직인 뒤에야 보낸다(시작이 굼뜬 원인).
    // pointermove는 2px부터 오므로 이동 계산은 포인터 이벤트로 한다(touch-action:none 필요).
    const STATUS_ROWS = SET.statusRows;  // tmux 상태줄(대화 탭) 줄 수 = cchat-tabs apply가 맞춘 status
    let pid = null, lastY = null, acc = 0, moves = 0, wheels = 0, reports = 0, downX = 0, downY = 0;
    // 손가락 위치 → 터미널 칸(열,줄). 여백을 뺀 실제 글자 영역(.xterm-screen) 기준.
    const cellAt = (x, y) => {
      const term = window.term;
      if (!term || !term.element) return null;
      const r = (term.element.querySelector('.xterm-screen') || term.element).getBoundingClientRect();
      const col = Math.min(term.cols, Math.max(1, Math.floor((x - r.left) / (r.width / Math.max(1, term.cols))) + 1));
      const row = Math.min(term.rows, Math.max(1, Math.floor((y - r.top) / (r.height / Math.max(1, term.rows))) + 1));
      return { col, row, last: row > term.rows - STATUS_ROWS && y >= r.top };
    };
    const onStatusRow = (y) => { const c = cellAt(0, y); return !!(c && c.last); };
    // claude 입력칸(─── 가로선 두 줄 사이, 선 포함)인가. 키보드는 여기를 탭할 때만 올린다.
    // 가로선을 못 찾으면(claude 화면이 아닐 때) true → 예전처럼 어디를 눌러도 키보드.
    const inInputBox = (row) => {
      const term = window.term;
      if (!term || !term.buffer) return true;
      const buf = term.buffer.active, base = buf.viewportY;
      const isRule = (r) => {
        const line = buf.getLine(base + r - 1);
        const t = line ? line.translateToString(true).trim() : '';
        return t.length >= 10 && /^─+$/.test(t);
      };
      const rules = [];
      for (let r = term.rows - STATUS_ROWS; r >= 1 && rules.length < 2; r--) if (isRule(r)) rules.push(r);
      if (rules.length < 2) return true;
      return row >= rules[1] && row <= rules[0];
    };
    // 길게 누르기(LONG ms, 손가락 거의 안 움직임) = 선택 모드: 그 자리에서 마우스 누름을 보내고,
    // 끄는 동안 마우스 드래그, 떼면 마우스 놓기를 보낸다. claude가 PC 드래그와 똑같이 선택하고
    // OSC 52로 복사 신호를 보내면 아래 installOsc52가 클립보드에 넣는다.
    const LONG = 450, SLOP = 10;
    let lpTimer = null, selecting = false, selCell = null, swallowTouchEnd = false;
    // 선택 모드 중에는 키보드가 필요 없다: 누르기 시작할 때 키보드가 내려가 있었으면 선택 모드 동안과
    // 뗀 뒤 1.5초까지 입력칸 포커스가 오거나 화면이 줄면(=키보드) 포커스를 뺀다(상태줄 탭과 같은 원인).
    let downKbUp = false, downH = 0, selGuardUntil = 0, selHits = [], selReports = 0;
    const selGuard = (why) => {
      if (downKbUp || Date.now() > selGuardUntil) return;
      const t = ta();
      if (document.activeElement === t || vh() < downH - 80) { selHits.push(why); if (t) t.blur(); }
    };
    // 화면 줄(1부터)의 글자와 칸 번호 대응. 한글처럼 두 칸짜리 글자가 있어도 칸 위치를 맞춘다.
    const rowText = (row) => {
      const term = window.term, buf = term.buffer.active;
      const line = buf.getLine(buf.viewportY + row - 1);
      let s = '', cols = [];
      if (!line) return { s, cols };
      for (let x = 0; x < term.cols; x++) {
        const cell = line.getCell(x);
        if (!cell || cell.getWidth() === 0) continue;
        const ch = cell.getChars() || ' ';
        s += ch; for (let k = 0; k < ch.length; k++) cols.push(x + 1);
      }
      return { s, cols };
    };
    // 그 칸에 걸친 http(s) 주소. 줄 끝까지 꽉 찬 주소는 다음 줄(claude가 접어 쓴 나머지)과 이어 붙인다.
    // claude는 긴 주소를 화면 오른쪽 끝에서 자르고 다음 줄(들여쓰기 뒤)에 이어 쓴다.
    const UC = /[^\s<>"'`│]/.source, URL_RE = new RegExp('https?://' + UC + '+', 'g');
    const EDGE = 3;  // 오른쪽 끝에서 이 칸 안에서 끝나면 "줄 끝에 닿음"
    const atEdge = (cols, i) => cols[i] >= window.term.cols - EDGE;
    // 다음 줄이 이어진 부분이면 {from, to(문자 위치), full(그 줄도 끝까지 참)}
    const contOf = (row) => {
      if (row > window.term.rows) return null;
      const t = rowText(row), m = t.s.match(new RegExp('^( {0,8})(' + UC + '+)( *)$')) || t.s.match(new RegExp('^( {0,8})(' + UC + '+)'));
      if (!m) return null;
      const from = m[1].length, to = from + m[2].length - 1;
      return { text: m[2], a: t.cols[from], b: t.cols[to], full: m[0].length === t.s.length && atEdge(t.cols, to) };
    };
    const urlAt = (row, col) => {
      const term = window.term;
      if (!term || !term.buffer) return null;
      // 이 줄이 앞 줄 주소의 이어진 부분이면 앞 줄부터 본다(여러 줄 이어질 수 있음).
      let start = row;
      while (start > 1 && row - start < 10) {
        const pv = rowText(start - 1), prev = pv.s.replace(/\s+$/, '');
        if (!prev || !atEdge(pv.cols, prev.length - 1) || !new RegExp(UC + '$').test(prev)) break;
        if (!contOf(start)) break;
        start--;
      }
      for (let r = start; r <= row; r++) {
        const { s, cols } = rowText(r);
        for (const m of s.matchAll(URL_RE)) {
          const last = m.index + m[0].length - 1;
          let url = m[0], hit = r === row && col >= cols[m.index] && col <= cols[last];
          // 줄 끝에 닿았으면 다음 줄들의 앞부분을 이어 붙인다.
          if (s.slice(last + 1).trim() === '' && atEdge(cols, last)) {
            for (let rr = r + 1; rr <= term.rows && rr - r <= 10; rr++) {
              const c = contOf(rr);
              if (!c) break;
              url += c.text;
              if (rr === row && col >= c.a && col <= c.b) hit = true;
              if (!c.full) break;
            }
          }
          if (hit) return url.replace(/[.,;:!?)\]}'"]+$/, '');
        }
      }
      return null;
    };
    window.__cchatUrlAt = urlAt;
    const mouse = (b, c, up) => window.term && window.term.input(`\u001b[<${b};${c.col};${c.row}${up ? 'm' : 'M'}`, true);
    const cancelLong = () => { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } };
    el.addEventListener('contextmenu', (e) => e.preventDefault(), { capture: true });
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      if (pid !== null) { pid = null; lastY = null; cancelLong(); return; }  // 두 손가락이면 스크롤 안 함
      pid = e.pointerId; lastY = e.clientY; acc = 0; moves = 0; wheels = 0;
      downX = e.clientX; downY = e.clientY;
      selecting = false; cancelLong();
      if (onStatusRow(e.clientY)) return;
      downKbUp = kbUp(); downH = vh(); selGuardUntil = 0;  // 새로 누르면 이전 탭의 키보드 가드는 끝
      const dc = cellAt(downX, downY);
      if (!downKbUp && dc && !inInputBox(dc.row) && ta() && document.activeElement === ta()) ta().blur();
      const id = e.pointerId;
      lpTimer = setTimeout(() => {
        lpTimer = null;
        if (pid !== id || wheels) return;
        const c = cellAt(downX, downY);
        if (!c || c.last) return;
        selecting = true; selCell = c; selHits = [];
        selGuardUntil = Infinity; selGuard('s');
        mouse(0, c, false);
        if (navigator.vibrate) navigator.vibrate(15);
        toast('선택 모드: 끌어서 선택, 떼면 복사');
      }, LONG);
    }, { passive: true, capture: true });
    const end = (e) => {
      if (e.pointerId !== pid) return;
      pid = null; lastY = null; cancelLong();
      if (selecting) {
        selecting = false; swallowTouchEnd = true;
        selGuardUntil = Date.now() + 1500;
        for (const ms of [50, 300, 800]) setTimeout(() => selGuard('t' + ms), ms);
        setTimeout(() => { if (selReports++ < 5) beacon(`lsel-${downKbUp ? 1 : 0}-${selHits.join('.') || 'none'}-${Math.round(downH)}-${Math.round(vh())}`); }, 1600);
        const c = cellAt(e.clientX, e.clientY) || selCell;
        mouse(0, c.last ? selCell : c, true);
        return;
      }
      // 실제 폰에서 드래그가 잡혔는지 ttyd 로그에 남긴다(처음 5번만): touch/움직임수/보낸휠수
      if (moves && reports++ < 5) beacon(`touch-${moves}-${wheels}`);
      // 가로로 빠르게 밀기(세로 스크롤이 안 일어난 경우만) = 이전/다음 대화. 왼쪽으로 밀면 다음(Alt+→), 오른쪽은 이전(Alt+←).
      if (e.type === 'pointerup' && !wheels && window.term) {
        const dx = e.clientX - downX, dy = e.clientY - downY;
        if (Math.abs(dx) > 70 && Math.abs(dy) < 45 && Math.abs(dx) > 2 * Math.abs(dy)) {
          swallowTouchEnd = true;
          window.term.input(dx < 0 ? '\u001b[1;3C' : '\u001b[1;3D', true);
          return;
        }
      }
      // 맨 아래 상태줄(대화 탭, STATUS_ROWS줄)을 톡 치면 마우스 클릭으로 보낸다 → 대화 번호를 눌러 그 대화로 전환.
      const term = window.term;
      if (e.type !== 'pointerup' || wheels || !term) return;
      if (Math.abs(e.clientX - downX) > 12 || Math.abs(e.clientY - downY) > 12) return;
      const c = cellAt(downX, downY);
      if (!c) return;
      // 주소(URL)를 톡 치면 새 창으로 연다. PC는 마우스를 올려야 링크가 잡히는데 폰에는 그게 없어서 눌러도 안 열렸다.
      if (!c.last && !inInputBox(c.row)) {
        const url = urlAt(c.row, c.col);
        if (url) {
          swallowTouchEnd = true;
          if (!downKbUp && ta()) ta().blur();
          window.open(url, '_blank', 'noopener');
          toast('열기: ' + (url.length > 60 ? url.slice(0, 57) + '…' : url));
          return;
        }
      }
      // 대화 화면 탭(키보드 내려간 상태, 입력칸 밖): 키보드 없이 클릭만 보낸다(Jump to bottom 등).
      if (!c.last) {
        if (downKbUp || inInputBox(c.row)) return;  // 키보드가 이미 올라와 있거나 입력칸이면 원래대로
        swallowTouchEnd = true;
        selHits = []; selGuardUntil = Date.now() + 1500; selGuard('c');
        for (const ms of [50, 300, 800]) setTimeout(() => selGuard('t' + ms), ms);
        mouse(0, c, false); mouse(0, c, true);
        return;
      }
      const { col, row } = c;
      term.input(`\\u001b[<0;${col};${row}M\\u001b[<0;${col};${row}m`, true);
    };
    el.addEventListener('pointerup', end, { passive: true, capture: true });
    el.addEventListener('pointercancel', end, { passive: true, capture: true });
    // 상태줄(맨 아래 STATUS_ROWS줄)을 누를 때는 터치 기본 동작을 막아 입력칸에 포커스가 가지 않게 한다
    // → 키보드가 내려가 있으면 그대로 둔다. 클릭은 위 pointerup이 tmux로 보낸다.
    for (const type of ['touchstart', 'touchend']) {
      el.addEventListener(type, (e) => {
        const t = e.changedTouches[0];
        if (type === 'touchend' && swallowTouchEnd) {
          swallowTouchEnd = false;
          if (e.cancelable) e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (e.touches.length > 1 || !t || !onStatusRow(t.clientY)) return;
        if (e.cancelable) e.preventDefault();
        e.stopPropagation();
      }, { passive: false, capture: true });
    }
    // 위로 막아도 실제 폰에서는 키보드가 올라오는 경우가 있어서(2026-11-05 확인), 상태줄 탭 직후
    // 입력칸에 포커스가 오거나 화면 높이가 줄면(=키보드가 올라옴) 포커스를 빼서 키보드를 내린다.
    // 탭 전부터 키보드가 올라와 있었으면 건드리지 않는다.
    // 폰은 키보드를 내려도 입력칸 포커스는 남아 있어서(stap-1-...-800-461), 키보드 상태는 화면 높이로 판단한다.
    let stap = null, stapReports = 0, maxH = 0;
    const vh = () => (window.visualViewport ? window.visualViewport.height : innerHeight);
    const kbUp = () => { const h = vh(); maxH = Math.max(maxH, h); return h < maxH - 80; };
    if (window.visualViewport) window.visualViewport.addEventListener('resize', kbUp);
    kbUp();
    const ta = () => (window.term && window.term.textarea) || document.querySelector('.xterm-helper-textarea');
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch' || !onStatusRow(e.clientY)) { stap = null; return; }
      const up = kbUp(), t = ta(), foc = document.activeElement === t;
      stap = { t: Date.now(), h: vh(), foc: up, hadFocus: foc, hits: [] };
      // 키보드가 내려가 있는데 포커스만 남아 있으면 지금 빼 둔다(탭이 키보드를 다시 부르지 않게).
      if (!up && foc && t) { t.blur(); stap.hits.push('d'); }
    }, { passive: true, capture: true });
    const guard = (why) => {
      if (!stap || stap.foc || Date.now() - stap.t > 1500) return;
      const t = ta();
      if (document.activeElement === t || vh() < stap.h - 80) { stap.hits.push(why); if (t) t.blur(); }
    };
    document.addEventListener('focusin', () => { guard('f'); selGuard('f'); }, true);
    if (window.visualViewport) window.visualViewport.addEventListener('resize', () => { guard('r'); selGuard('r'); });
    el.addEventListener('pointerup', () => {
      if (!stap) return;
      const s0 = stap;
      for (const ms of [50, 200, 500, 1000]) setTimeout(() => guard('t' + ms), ms);
      setTimeout(() => { if (stapReports++ < 5) beacon(`stap-${s0.foc ? 1 : 0}${s0.hadFocus ? 1 : 0}-${s0.hits.join('.') || 'none'}-${Math.round(s0.h)}-${Math.round(vh())}`); }, 1300);
    }, { passive: true, capture: true });
    // xterm.js 자체 터치 처리는 막는다(스크롤은 아래 pointermove가 맡음).
    el.addEventListener('touchmove', (e) => {
      if (e.touches.length !== 1) return;
      if (e.cancelable) e.preventDefault();
      e.stopPropagation();
    }, { passive: false, capture: true });
    el.addEventListener('pointermove', (e) => {
      const term = window.term;
      if (e.pointerId !== pid || lastY === null || !term) return;
      moves++;
      if (selecting) {
        const c = cellAt(e.clientX, e.clientY);
        if (c && !c.last && (c.col !== selCell.col || c.row !== selCell.row)) { selCell = c; mouse(32, c, false); }
        return;
      }
      if (lpTimer && (Math.abs(e.clientX - downX) > SLOP || Math.abs(e.clientY - downY) > SLOP)) cancelLong();
      if (lpTimer) return;  // 길게 누르기 판정 중에는 스크롤하지 않는다(손떨림으로 화면이 움직이지 않게)
      const t = e;
      const r = (term.element || el).getBoundingClientRect();
      const ch = r.height / Math.max(1, term.rows), cw = r.width / Math.max(1, term.cols);
      const col = Math.min(term.cols, Math.max(1, Math.floor((t.clientX - r.left) / cw) + 1));
      const row = Math.min(term.rows, Math.max(1, Math.floor((t.clientY - r.top) / ch) + 1));
      acc += t.clientY - lastY;
      lastY = t.clientY;
      const unit = ch * STEP;
      let seq = '';
      // 드래그 첫 칸은 FIRST만큼만 움직여도 바로 보낸다(시작 반응이 늦지 않게).
      for (let need = wheels ? unit : unit * FIRST; Math.abs(acc) >= need; need = unit) {
        const up = acc > 0;
        seq += `\\u001b[<${up ? 64 : 65};${col};${row}M`;
        acc += up ? -need : need;
        wheels++;
      }
      if (seq) term.input(seq, true);
    }, { passive: true, capture: true });
  };

  // 드래그 복사: claude(전체화면)는 선택한 글을 OSC 52(ESC]52;c;base64)로 보내고 tmux가 그대로 넘겨 주는데,
  // ttyd의 xterm.js에는 이를 받는 처리가 없어서 복사가 안 됐다(2026-11-05). 받아서 브라우저 클립보드에 넣는다.
  const copyText = (text) => {
    const done = () => toast('복사됨');
    const fallback = () => {
      const t = document.createElement('textarea');
      t.value = text; t.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
      document.body.appendChild(t); t.select();
      try { if (document.execCommand('copy')) done(); } catch (e) {}
      t.remove();
      if (window.term) window.term.focus();
    };
    // 폰(특히 iOS)은 손가락을 뗀 뒤 비동기로 오는 복사를 막을 수 있다 → 그때는 '눌러서 복사' 버튼을 띄운다.
    const ask = () => button('눌러서 복사', () => navigator.clipboard.writeText(text).then(done, () => toast('복사 실패')));
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, mobile ? ask : fallback);
    else if (mobile) ask();
    else fallback();
  };
  const button = (label, onTap) => {
    let b = document.getElementById('cchat-copybtn');
    if (!b) {
      b = document.createElement('button'); b.id = 'cchat-copybtn';
      b.style.cssText = 'position:fixed;left:50%;top:12px;transform:translateX(-50%);z-index:10000;padding:8px 16px;'
        + 'border:0;border-radius:8px;background:#2f6fde;color:#fff;font:15px sans-serif';
      document.body.appendChild(b);
    }
    b.textContent = label; b.style.display = 'block';
    b.onclick = (e) => { e.preventDefault(); b.style.display = 'none'; onTap(); };
    clearTimeout(b._t); b._t = setTimeout(() => { b.style.display = 'none'; }, 6000);
  };
  const toast = (msg) => {
    let el = document.getElementById('cchat-toast');
    if (!el) {
      el = document.createElement('div'); el.id = 'cchat-toast';
      el.style.cssText = 'position:fixed;left:50%;top:12px;transform:translateX(-50%);z-index:9999;padding:4px 12px;'
        + 'border-radius:6px;background:rgba(40,40,40,.85);color:#fff;font:13px sans-serif;pointer-events:none;transition:opacity .3s';
      document.body.appendChild(el);
    }
    el.textContent = msg; el.style.opacity = '1';
    clearTimeout(el._t); el._t = setTimeout(() => { el.style.opacity = '0'; }, 1200);
  };
  const installOsc52 = (term) => {
    if (term.__cchatOsc52 || !term.parser) return;
    term.__cchatOsc52 = true;
    term.parser.registerOscHandler(52, (data) => {
      const i = data.indexOf(';');
      const b64 = i < 0 ? data : data.slice(i + 1);
      if (!b64 || b64 === '?') return true;
      try {
        const bytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
        copyText(new TextDecoder().decode(bytes));
      } catch (e) {}
      return true;
    });
  };

  // PC 대화 탭 단축키: Alt(Option)+숫자 = 그 번호 대화, Alt+←/→ = 이전/다음 대화, Alt+↑/↓ = 위/아래 칸(여러 줄 모드).
  // 맥 Option+숫자는 ¡ 같은 글자가 돼 버리므로 e.code로 잡아 tmux의 M-숫자 / M-←→ 키로 보낸다(tmux.conf가 탭 이동으로 묶음).
  // 세션 목록(cchat-ls, Alt+L)이 떠 있을 때 한글 입력 상태로 누른 키(ㅌ 등)는 IME가 조합 중으로 붙잡아 두어
  // 다음 키를 칠 때까지 터미널로 안 간다. 목록이 떠 있으면 조합 글자(자모 하나)를 바로 보내고(cchat-ls가 ㅌ→x 처럼 받음),
  // 조합이 끝날 때 xterm이 같은 글자를 또 보내지 않게 막는다. 조합 중 Enter도 바로 보낸다. 목록인지는 팝업 머리줄 글자로 안다.
  const lsOpen = () => {
    const t = window.term; if (!t) return false;
    const b = t.buffer.active;
    for (let y = 0; y < 3; y++) { const l = b.getLine(b.viewportY + y); if (l && l.translateToString(true).includes('Claude 세션 —')) return true; }
    return false;
  };
  let lsComp = false;
  const JAMO = /^[\u3131-\u3163]$/;
  document.addEventListener('compositionstart', (e) => {
    const t = window.term && window.term.textarea;
    lsComp = !!t && e.target === t && lsOpen();
  }, true);
  document.addEventListener('compositionupdate', (e) => {
    if (lsComp && JAMO.test(e.data || '')) window.term.input(e.data, true);
  }, true);
  document.addEventListener('compositionend', (e) => {
    if (!lsComp) return;
    lsComp = false;
    e.stopImmediatePropagation();
    const t = window.term && window.term.textarea;
    setTimeout(() => { if (t) t.value = ''; }, 0);
  }, true);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.isComposing || e.keyCode === 229) && lsOpen() && window.term) {
      e.preventDefault(); e.stopImmediatePropagation(); window.term.input('\\r', true);
    }
  }, true);
  if (!mobile) {
    window.addEventListener('keydown', (e) => {
      // Ctrl+V: 터미널로 ^V를 보내면 claude가 ttyd를 돌리는 맥의 클립보드를 읽어 붙인다. 키는 막고(전파 중단)
      // 브라우저 기본 붙여넣기만 일어나게 해서 PC 클립보드가 들어가게 한다(preventDefault는 하지 않는다).
      if (e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyV') { e.stopImmediatePropagation(); return; }
      // Shift+Enter: xterm은 그냥 Enter(\\r)를 보내 입력이 전송돼 버린다. claude 입력칸 줄바꿈인 ESC+Enter로 바꿔 보낸다(폰 키바 ⇧⏎와 같음).
      if (e.key === 'Enter' && e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && !e.isComposing && window.term) {
        e.preventDefault(); e.stopImmediatePropagation(); window.term.input('\u001b\\r', true); return;
      }
      if (!e.altKey || e.ctrlKey || e.metaKey || !window.term) return;
      let seq = null;
      const m = /^Digit([0-9])$/.exec(e.code);
      if (m) seq = '\u001b' + m[1];
      else if (e.code === 'KeyL') seq = '\u001bl';  // Alt+L = 세션 목록(맥 Option+L은 ¬가 돼 버려서)
      else if (e.code === 'ArrowLeft') seq = '\u001b[1;3D';
      else if (e.code === 'ArrowRight') seq = '\u001b[1;3C';
      // Alt+↑/↓ = 위/아래 칸 탭: 여러 줄 모드(tab rows 2~5)에서만. 1줄 모드는 그대로 claude에 보낸다.
      else if (SET.tabRows > 1 && e.code === 'ArrowUp') seq = '\u001b[1;3A';
      else if (SET.tabRows > 1 && e.code === 'ArrowDown') seq = '\u001b[1;3B';
      if (!seq) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      window.term.input(seq, true);
    }, true);
  }

  // 작업 중 탭 스피너: cchat-tabs가 작업 중 탭의 빈칸 글자색을 BUSY_MARK(256색 123번)로 칠해 둔다(빈칸이라 안 보임).
  // 1초마다 탭 위 줄(번호 줄)을 읽어 그 탭의 번호 바로 뒤 빈칸을 찾고, 그 자리에 도는 점자 기호(⠋⠙⠹…)를 얹는다.
  // 터미널 글자는 건드리지 않고(다시 그리기 없음), 기호는 입력을 통과시킨다(pointer-events:none).
  // 모든 탭의 기호는 시계 기준으로 같은 모양을 보여 같이 돈다.
  const BUSY_MARK = 123, SPIN_MS = 350;
  let busyKey = '';
  // 점 6개(1·2·3 왼쪽 열 위→아래, 4·5·6 오른쪽 열)를 고리로 보고, 머리 점이 시계 방향으로 돌며
  // 뒤따르는 꼬리 두 점이 점점 옅어진다. 한 칸 = SPIN_MS.
  const RING = [0, 3, 4, 5, 2, 1];          // 점1 → 점4 → 점5 → 점6 → 점3 → 점2
  const TAIL = [1, 0.8, 0.5, 0, 0, 0];    // 머리에서 떨어진 거리별 진하기
  const spinFrame = (now) => Math.floor((now || Date.now()) / SPIN_MS) % RING.length;
  const paintSpin = (d, f) => {
    if (d.dataset.f === String(f)) return;
    d.dataset.f = f;
    RING.forEach((k, p) => {
      d.children[k].style.opacity = TAIL[(f - p + RING.length) % RING.length];
    });
  };
  const busyLayer = () => {
    let el = document.getElementById('cchat-busy');
    if (!el) {
      const st = document.createElement('style');
      st.textContent = '#cchat-busy{position:fixed;inset:0;pointer-events:none;z-index:5}'
        + '#cchat-busy>div{position:fixed;pointer-events:none;display:grid;grid-template-rows:repeat(3,auto);grid-auto-flow:column;place-content:center}'
        + '#cchat-busy i{border-radius:50%;background:currentColor;opacity:0}';
      document.head.appendChild(st);
      el = document.createElement('div');
      el.id = 'cchat-busy';
      document.body.appendChild(el);
    }
    return el;
  };
  const scanBusy = () => {
    const term = window.term;
    if (!term || !term.buffer || document.hidden) return;
    const buf = term.buffer.active, rows = term.rows, cols = term.cols;
    const spots = [];
    // 탭 줄(맨 아래 SET.statusRows줄) 중 작업 중 표시가 있는 줄. 기본 모드는 위 줄(번호)에만 표시가 있다.
    for (let y = rows - SET.statusRows; y < rows; y++) {
    const line = buf.getLine(buf.viewportY + y);
    if (line) {
      let x = 0;
      while (x < cols) {
        const c = line.getCell(x);
        if (c && c.isFgPalette() && c.getFgColor() === BUSY_MARK) {
          // 같은 바탕색이 이어지는 데까지가 그 탭(탭 사이는 바탕색 없는 한 칸)
          const bg = c.getBgColor();
          let a = x, b = x;
          while (a > 0) { const p = line.getCell(a - 1); if (!p || p.getBgColor() !== bg || p.isBgDefault()) break; a--; }
          while (b < cols - 1) { const n = line.getCell(b + 1); if (!n || n.getBgColor() !== bg || n.isBgDefault()) break; b++; }
          // 번호 끝 다음 칸을 한 칸 띄우고 기호 자리로
          let e = a;
          while (e <= b && !(line.getCell(e).getChars() || ' ').trim()) e++;
          while (e <= b && (line.getCell(e).getChars() || ' ').trim()) e++;
          // 한 줄짜리 탭(여러 줄 모드)은 탭 맨 오른쪽 칸, 두 줄 탭(기본 모드·높이 2)은 번호 뒤 한 칸 띄운 자리(칸이 모자라면 바로 뒤)
          const at = !SET.tabTwoLine ? b : e + 1 <= b ? e + 1 : e;
          // 점 색 = 그 탭 글자색(꼬리는 진하기만 옅어짐)
          const nc = line.getCell(Math.max(a, e - 1));
          const pal = theme.extendedAnsi || [];
          const fi = nc && nc.isFgPalette() ? nc.getFgColor() : -1;
          const color = fi >= 16 && pal[fi - 16] ? pal[fi - 16] : theme.foreground;
          if (at <= b) spots.push([y, at, color]);
          x = b + 1;
        } else x++;
      }
    }
    }
    const scr = term.element && term.element.querySelector('.xterm-screen');
    const r = scr ? scr.getBoundingClientRect() : null;
    const key = r ? `${spots.join('|')}@${r.left},${r.top},${r.width},${r.height},${cols},${rows}` : '';
    if (key === busyKey) return;
    busyKey = key;
    const el = busyLayer();
    el.textContent = '';
    if (!r || !spots.length) return;
    const cw = r.width / cols, ch = r.height / rows;
    for (const [y, at, color] of spots) {
      const d = document.createElement('div');
      // 점자 글자 대신 점 6개를 직접 그린다: 폰 글꼴은 점자 기호마다 폭이 달라 오른쪽 열만 있는 ⠸가 왼쪽으로 튀었다.
      const dot = Math.max(2, +(ch * 0.165).toFixed(1)), gap = Math.max(1, +(ch * 0.075).toFixed(1));  // 반올림하면 작은 차이가 사라져 소수점 px
      d.style.cssText = `left:${r.left + at * cw}px;top:${r.top + y * ch}px;width:${cw}px;height:${ch}px;gap:${gap}px;color:${color}`;
      for (let k = 0; k < 6; k++) { const i = document.createElement('i'); i.style.cssText = `width:${dot}px;height:${dot}px`; d.appendChild(i); }
      paintSpin(d, spinFrame());
      el.appendChild(d);
    }
  };
  setInterval(scanBusy, 1000);
  // 다음 칸 경계 직후로 타이머를 매번 다시 맞춘다. setInterval(150)은 폰에서 타이머가 조금씩 밀리면
  // 경계 앞뒤로 두 번 걸려 같은 모양이 두 번 나오고 다음 모양을 건너뛰어(삐끗) 보였다.
  const spinTick = () => {
    const now = Date.now();
    const el = document.getElementById('cchat-busy');
    if (el && el.firstChild && !document.hidden) {
      const f = spinFrame(now);
      for (const d of el.children) paintSpin(d, f);
    }
    setTimeout(spinTick, SPIN_MS - (now % SPIN_MS) + 5);
  };
  spinTick();

  // 웹 푸시 알림(PC·안드로이드 Chrome): 원격 중계가 ./sw.js와 ./push/key를 내줄 때만 켜진다(이 맥 주소로 바로 열면 404라 아무것도 안 함).
  // 허락 전이면 오른쪽 위에 '알림 켜기' 버튼을 띄우고(× 로 숨김), 허락돼 있으면 열 때마다 구독을 중계에 다시 알린다.
  const pushSetup = async () => {
    if (!window.isSecureContext || !('serviceWorker' in navigator) || !('PushManager' in window) || !window.Notification) return;
    if (Notification.permission === 'denied') return;
    let key;
    try { const r = await fetch('./push/key', { cache: 'no-store' }); if (!r.ok) return; key = (await r.text()).trim(); } catch (_) { return; }
    const b64 = (k) => { const s = atob((k + '='.repeat((4 - k.length % 4) % 4)).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from(s, (c) => c.charCodeAt(0)); };
    const subscribe = async () => {
      const reg = await navigator.serviceWorker.register('./sw.js', { scope: './' });
      await navigator.serviceWorker.ready;
      let sub = await reg.pushManager.getSubscription();
      const want = b64(key), have = sub && sub.options.applicationServerKey && new Uint8Array(sub.options.applicationServerKey);
      if (sub && !(have && have.length === want.length && have.every((v, i) => v === want[i]))) {
        await sub.unsubscribe(); sub = null;
      }
      if (!sub) sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64(key) });
      await fetch('./push/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ subscription: sub.toJSON(), device: mobile ? 'phone' : 'pc' }) });
    };
    if (Notification.permission === 'granted') { subscribe().catch((e) => console.warn('cchat push', e)); return; }
    try { if (localStorage.getItem('cchat-push-hide')) return; } catch (_) {}
    const bar = document.createElement('div');
    bar.id = 'cchat-push';
    bar.style.cssText = 'position:fixed;top:8px;right:8px;z-index:20;display:flex;gap:2px;font:600 13px/1 system-ui,sans-serif;'
      + 'border-radius:8px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.25)';
    const btn = (t) => { const b = document.createElement('button'); b.textContent = t;
      b.style.cssText = 'border:0;padding:8px 10px;cursor:pointer;background:' + (dark ? '#2d333b;color:#e6edf3' : '#24292f;color:#fff'); return b; };
    const on = btn('🔔 알림 켜기'), off = btn('×');
    on.onclick = async () => {
      bar.remove();
      if (await Notification.requestPermission() === 'granted') subscribe().catch((e) => alert('알림 등록 실패: ' + e.message));
    };
    off.onclick = () => { bar.remove(); try { localStorage.setItem('cchat-push-hide', '1'); } catch (_) {} };
    bar.append(on, off);
    document.body.appendChild(bar);
  };
  setTimeout(pushSetup, 1500);

  // 허락·질문 선택지 버튼: 화면 아래쪽에 "❯ 1. Yes / 2. … / 3. No" 같은 번호 목록이 보이면 그 번호만 버튼으로 띄운다.
  // 폰에서 키보드를 올리지 않고 한 번에 고르게(PC는 클릭). 목록이 사라지면 버튼도 사라진다.
  const CHOICE_RE = /^[\\s│|]*(?:❯\\s*)?([1-9])\\.\\s+(.{1,60}?)\\s*[│|]?\\s*$/;
  let choiceKey = '';
  const scanChoices = () => {
    const term = window.term;
    if (!term || !term.buffer || document.hidden) return;
    const buf = term.buffer.active, rows = term.rows, found = [];
    let cursor = false;  // claude 선택 목록에는 고른 줄 앞에 ❯가 있다(답 속 번호 목록과 구분)
    for (let y = 0; y < rows - SET.statusRows; y++) {
      const line = buf.getLine(buf.viewportY + y);
      const m = line && CHOICE_RE.exec(line.translateToString(true));
      if (m) { found.push([m[1], m[2]]); if (/❯/.test(line.translateToString(true))) cursor = true; }
    }
    // 1부터 차례로 이어지는 2개 이상만 선택지로 본다
    const opts = [];
    for (const [n, t] of found) { if (Number(n) === opts.length + 1) opts.push([n, t]); else if (Number(n) === 1) { opts.length = 0; opts.push([n, t]); } }
    const key = opts.length >= 2 && cursor ? opts.map((o) => o.join(':')).join('|') : '';
    if (key === choiceKey) return;
    choiceKey = key;
    let bar = document.getElementById('cchat-choices');
    if (!key) { if (bar) bar.remove(); return; }
    if (!bar) {
      bar = document.createElement('div');
      bar.id = 'cchat-choices';
      bar.style.cssText = 'position:fixed;right:8px;z-index:12;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100vw - 16px);'
        + 'bottom:' + (mobile ? 'calc(96px + env(safe-area-inset-bottom))' : '64px');  // 키 바·탭 두 줄 위
      document.body.appendChild(bar);
    }
    bar.textContent = '';
    for (const [n, t] of opts.slice(0, 5)) {
      const b = document.createElement('button');
      b.textContent = `${n} ${t.length > 18 ? t.slice(0, 17) + '…' : t}`;
      b.title = t;
      b.style.cssText = 'border:0;border-radius:16px;padding:8px 12px;font:600 13px system-ui,sans-serif;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.3);'
        + (/^no\\b|아니|거절/i.test(t) ? 'background:#cf222e;color:#fff' : n === '1' ? 'background:#1f883d;color:#fff' : 'background:#57606a;color:#fff');
      b.addEventListener('pointerdown', (e) => { e.preventDefault(); if (window.term) window.term.input(n, true); });
      b.addEventListener('mousedown', (e) => e.preventDefault());
      bar.appendChild(b);
    }
  };
  setInterval(scanChoices, 600);

  // 알림을 눌렀을 때 이미 열린 창이면: 서비스 워커가 보낸 메시지로 페이지를 새로 불러오지 않고 그 대화로 바로 다시 붙는다.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.addEventListener('message', (e) => {
      const d = e.data || {};
      if (d.type !== 'cchat-open' || !/^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$/.test(d.session || '')) return;
      if (d.session === curSession) return;
      curSession = d.session;
      try { history.replaceState(history.state, '', withSession(location.href)); } catch (_) {}
      tries = 0;
      // 번호 한 자리 대화(0=main, 1~9)는 Alt+숫자 키로 tmux가 바로 바꾼다. 그 밖의 이름은 그 대화로 다시 붙는다.
      const digit = d.session === 'main' ? '0' : (/^[0-9]$/.test(d.session) ? d.session : null);
      if (digit && window.term && sock && sock.readyState === 1) { window.term.input('\\u001b' + digit, true); return; }
      if (sock && sock.readyState <= 1) { sock.close(); setTimeout(() => reconnect('notify'), 1600); }
    });
  }
  window.__cchatChoices = () => choiceKey;

  // 화면 켜짐 유지: 페이지가 보이는 동안, 작업 중인 탭이 있거나 1분 안에 화면 출력이 있으면 화면이 꺼지지 않게 한다.
  let wakeLock = null, lastOut = Date.now();
  const wakeTick = async () => {
    const term = window.term;
    if (term && !term.__cchatOut && term.onWriteParsed) { term.__cchatOut = true; term.onWriteParsed(() => { lastOut = Date.now(); }); }
    const want = !document.hidden && (Date.now() - lastOut < 60000 || /\\d/.test(busyKey.split('@')[0]));
    try {
      if (want && !wakeLock && navigator.wakeLock) { wakeLock = await navigator.wakeLock.request('screen'); wakeLock.addEventListener('release', () => { wakeLock = null; }); }
      else if (!want && wakeLock) { await wakeLock.release(); wakeLock = null; }
    } catch (_) {}
  };
  setInterval(wakeTick, 5000);
  window.__cchatWake = () => !!wakeLock;

  // 첫 화면 안내: 이 브라우저에서 처음 열었을 때 한 번만(닫으면 다시 안 뜸). 한국어 브라우저면 한국어.
  const firstHint = () => {
    try { if (localStorage.getItem('cchat-hint-v1')) return; } catch (_) { return; }
    const ko = /^ko/i.test(navigator.language || '');
    const lines = ko
      ? (mobile
        ? ['아래 줄이 대화 탭 — 누르면 바뀜, + 는 새 대화', '⠹ = 작업 중 · 주황 = 확인 필요 · 녹색 = 끝남', '손가락으로 끌면 스크롤, 맨 아래 키 바로 Esc·Tab·방향키', '설정은 claude에게 말로 (예: "폰 글자 크게")']
        : ['아래 줄이 대화 탭 — 클릭 또는 Alt+숫자, Alt+←/→', '+ 는 새 대화 (또는 주소에 ?arg=이름)', '⠹ = 작업 중 · 주황 = 확인 필요 · 녹색 = 끝남', '설정은 claude에게 말로 (예: "PC는 다크 테마로")'])
      : (mobile
        ? ['Bottom rows are session tabs — tap to switch, + opens a new one', '⠹ = working · orange = needs you · green = done', 'Drag to scroll; the key bar has Esc, Tab and arrows', 'Change settings by asking claude (e.g. "bigger font on my phone")']
        : ['Bottom rows are session tabs — click, or Alt+number, Alt+←/→', '+ opens a new session (or ?arg=name in the URL)', '⠹ = working · orange = needs you · green = done', 'Change settings by asking claude (e.g. "dark theme on PC")']);
    const card = document.createElement('div');
    card.id = 'cchat-hint';
    card.style.cssText = 'position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:25;max-width:min(440px,calc(100vw - 24px));'
      + 'padding:12px 14px;border-radius:10px;font:500 13px/1.5 system-ui,sans-serif;box-shadow:0 4px 18px rgba(0,0,0,.25);'
      + (dark ? 'background:#2d333b;color:#e6edf3' : 'background:#24292f;color:#fff');
    card.innerHTML = '<b>cchat</b><ul style="margin:6px 0 8px;padding-left:18px">' + lines.map((l) => '<li>' + l + '</li>').join('') + '</ul>';
    const ok = document.createElement('button');
    ok.textContent = ko ? '알겠어요' : 'Got it';
    ok.style.cssText = 'border:0;border-radius:6px;padding:6px 12px;font:600 13px system-ui,sans-serif;cursor:pointer;background:#4f967a;color:#fff';
    ok.onclick = () => { card.remove(); try { localStorage.setItem('cchat-hint-v1', '1'); } catch (_) {} };
    card.appendChild(ok);
    document.body.appendChild(card);
  };
  setTimeout(firstHint, 1200);

  // ttyd가 터미널을 새로 만들거나 설정을 덮어써도 0.5초 안에 기기별 색으로 되돌린다.
  const apply = () => {
    const term = window.term;
    if (!term || !term.options) return;
    installOsc52(term);
    installTitle(term);
    const cur = term.options.theme || {};
    if (cur.background !== theme.background || cur.black !== theme.black) term.options.theme = theme;
    // cchat-set font pc|phone <px>: 기기별 글자 크기. 바꾼 뒤 ttyd의 term.fit()으로 칸 수를 다시 맞춘다(서버에도 크기가 전달됨).
    const font = mobile ? SET.fontPhone : SET.fontPc;
    if (font && term.options.fontSize !== font) {
      term.options.fontSize = font;
      setTimeout(() => { try { typeof term.fit === 'function' ? term.fit() : window.dispatchEvent(new Event('resize')); } catch (_) {} }, 50);
    }
    if (mobile && document.body && !document.getElementById('cchat-keys')) buildKeys();
    if (mobile) installTouchScroll();
  };
  setInterval(apply, 500);
  apply();
  setTimeout(() => beacon('t5'), 5000);
})();
</script>"""


def free_port() -> int:
    """임시 ttyd용 빈 포트(예전엔 7699 고정이라 다른 서버가 쓰면 엉뚱한 HTML을 받았다)."""
    import socket
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def ttyd_version() -> str:
    try:
        return subprocess.run([TTYD, "--version"], capture_output=True, text=True, timeout=5).stdout.strip().split()[-1]
    except (OSError, IndexError, subprocess.SubprocessError):
        return "?"


def fetch_base_index() -> str:
    TEMP_PORT = free_port()
    proc = subprocess.Popen([TTYD, "-i", "lo0", "-p", str(TEMP_PORT), "true"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(50):
            try:
                req = urllib.request.Request(f"http://127.0.0.1:{TEMP_PORT}/",
                                             headers={"Accept-Encoding": "identity"})
                with urllib.request.urlopen(req, timeout=2) as res:
                    return res.read().decode("utf-8")
            except OSError:
                time.sleep(0.1)
        raise SystemExit("temporary ttyd did not respond")
    finally:
        proc.terminate()
        proc.wait(timeout=5)


def settings() -> dict:
    """cchat-set 값 중 페이지가 쓰는 것: 기기별 글자 크기(0=ttyd 기본), 기기별 테마, 저장한 지시문."""
    theme = lambda k, d: setting(k, d) if setting(k, d) in ("light", "dark") else d
    try:
        snips = [l.strip() for l in SNIPS.read_text(encoding="utf-8").splitlines() if l.strip()][:30]
    except OSError:
        snips = []
    rows = setting("tab.rows", "1")
    rows = min(5, max(1, int(rows))) if rows.isdigit() else 1
    try:  # 상태줄 줄 수는 탭 높이에 따라 달라져 cchat-tabs가 계산한 값을 쓴다
        out = subprocess.run(["@@HOME@@/.local/bin/cchat-tabs", "lines"], capture_output=True, text=True, timeout=5).stdout.split()
        lines, two = int(out[0]), out[1:] == ["two"]
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        lines, two = (2 if rows <= 1 else rows), rows <= 1
    return {"statusRows": lines, "tabTwoLine": two, "tabRows": rows, "fontPc": font_px("font.pc"), "fontPhone": font_px("font.phone"), "snips": snips,
            "themePc": theme("theme.pc", "light"), "themePhone": theme("theme.phone", "dark")}


def main() -> None:
    html = fetch_base_index()
    charset = '<meta charset="UTF-8">'
    if html.count(charset) != 1 or html.count("</head>") != 1 or 'name="viewport"' in html:
        raise SystemExit("unexpected ttyd index layout; inspect before injecting")
    script = (SCRIPT.replace("__LIGHT__", json.dumps(LIGHT))
              .replace("__DARK__", json.dumps(DARK))
              .replace("__KEYS__", json.dumps(KEYS))
              .replace("__MORE__", json.dumps(MORE))
              .replace("__BUILD__", time.strftime("%m%d%H%M"))
              .replace("__SET__", json.dumps(settings())))
    html = html.replace(charset, f"{charset}\n<!-- cchat: built by ~/.local/bin/cchat-build-index -->\n{VIEWPORT}", 1)
    html = html.replace("</head>", f"{STYLE}\n{MANIFEST}\n{script}\n</head>", 1)
    OUT.write_text(html, encoding="utf-8")
    # 이 페이지를 만든 ttyd 버전. cchat-ttyd(서비스 시작 래퍼)가 지금 ttyd와 다르면 다시 만든다.
    STAMP.write_text(ttyd_version() + "\n", encoding="utf-8")
    print(f"wrote {OUT} ({len(html)} chars)")


TERMUX_KEYS = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white", "brightBlack", "brightRed",
               "brightGreen", "brightYellow", "brightBlue", "brightMagenta", "brightCyan", "brightWhite"]


def termux_colors(name: str) -> str:
    """Termux(안드) ~/.termux/colors.properties. 페이지와 같은 색표(탭 줄 colour60~70 포함)라 ssh로 붙어도 같게 보인다."""
    t = DARK if name == "dark" else LIGHT
    out = [f"# cchat {name} — cchat-build-index --termux {name}", f"background={t['background']}",
           f"foreground={t['foreground']}", f"cursor={t['cursor']}"]
    out += [f"color{i}={t[k]}" for i, k in enumerate(TERMUX_KEYS)]
    out += [f"color{i + 16}={c}" for i, c in enumerate(t["extendedAnsi"])]
    return "\n".join(out) + "\n"


if __name__ == "__main__":
    if sys.argv[1:2] == ["--termux"]:
        print(termux_colors(sys.argv[2] if len(sys.argv) > 2 else "dark"), end="")
    else:
        main()
