#!/bin/zsh
# 자주 쓰는 지시문: 폰 키 바 ⋯ → ✎ 에서 눌러 입력칸에 넣는다(보내지는 않음). 저장: @@HOME@@/.config/cchat/snippets (한 줄에 하나)
#   cchat-snip                 목록
#   cchat-snip add "<지시문>"   추가
#   cchat-snip rm <번호>        지우기
# claude에게 "이 지시문 저장해 둬"라고 해도 이걸 쓴다. 바꾸면 페이지를 다시 만든다(브라우저 새로고침).
F=@@HOME@@/.config/cchat/snippets
touch $F
case "${1:-}" in
  "") [[ -s $F ]] && cat -n $F || print "(지시문 없음) cchat-snip add \"테스트 돌리고 결과만 요약해\"" ;;
  add) [[ -n "${2:-}" ]] || { print -u2 "내용을 주세요"; exit 2; }; print -r -- "${2//$'\n'/ }" >> $F; print "추가: $2" ;;
  rm) [[ "${2:-}" == <-> ]] || { print -u2 "번호를 주세요"; exit 2; }; sed -i '' "${2}d" $F; print "지움: $2" ;;
  *) sed -n '2,6p' $0 | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
[[ "${1:-}" == (add|rm) ]] && @@HOME@@/.local/bin/cchat-build-index >/dev/null && print "페이지를 다시 만들었습니다. 브라우저를 새로고침하세요."
exit 0
