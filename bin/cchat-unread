#!/bin/zsh
# claude 훅(config/claude-settings.json): cchat 대화에서 답이 끝났거나(done, Stop 훅) 허락이나 답을 기다리는데(ask: PermissionRequest 훅, AskUserQuestion·ExitPlanMode 직전 PreToolUse 훅)
# 사용자가 지금 그 대화를 보고 있지 않으면 tmux 세션 옵션 @unread=done|ask → 상태줄 탭이 녹색|주황.
# 아무것도 출력하지 않으므로 허락 창은 평소처럼 뜬다.
# busy(UserPromptSubmit 훅) = 작업 중 → @busy=1(탭이 은은하게 깜빡임(박자 cchat-set blink), 브라우저가 그림).
# idle(Notification idle_prompt 훅, 입력 대기 1분쯤) = 작업 중 표시만 끈다(Esc로 중단하면 Stop이 안 와서 남는 것 정리).
# done/ask는 작업 중 표시를 끄고 위 규칙대로 색을 켠다.
# "보고 있음" = 그 대화를 띄운 화면 중 하나가 2분 안에 입력(키·탭·스크롤)이 있었거나, 포커스를 가졌고(client_flags의 focused) 10분 안에 입력이 있었음.
#   예전엔 "가장 최근에 입력한 화면의 대화"만 봤더니, 브라우저를 뒤로 보내 두고 자리를 비운 사이 그 대화가 끝나면 표시가 안 됐다.
input=$(cat)  # 훅 입력 JSON(transcript_path 등)
kind=${1:-done}
[[ "$TMUX" == */@@TMUX_SOCKET@@,* && -n "$TMUX_PANE" ]] || exit 0
T=(@@BREW@@/tmux -L @@TMUX_SOCKET@@)
s=$($T display -p -t "$TMUX_PANE" '#{session_name}') || exit 0
refresh() { $T list-clients -F '#{client_name}' | while read -r c; do $T refresh-client -t "$c" -S; done; }
if [[ "$kind" == resume ]]; then
  # PostToolUse 훅(도구 하나 끝날 때마다): 허락하거나 질문에 답한 뒤 claude가 계속 일하는데 작업 중 표시가 꺼져 있던 것을 다시 켠다.
  # 이미 켜져 있으면 아무것도 안 한다(도구마다 불려서 가볍게). 아직 남은 주황(ask) 표시도 지운다.
  [[ "$($T show -t "=$s:" -qv @unread)" == ask ]] && { $T set -u -t "=$s:" @unread; refresh; }
  [[ -n "$($T show -t "=$s:" -qv @busy)" ]] && exit 0
  kind=busy
fi
# 탭에 보일 숫자: 작업 시작 시각(@busy_since → "3m"), 끝나면 지금 대화 크기(@ctx → "42k", 마지막 응답의 입력 토큰 합).
ctx_from_transcript() {
  print -r -- "$input" | /usr/bin/python3 -I -c '
import json, os, sys
try:
    p = json.loads(sys.stdin.read() or "{}").get("transcript_path") or ""
    with open(os.path.expanduser(p), "rb") as f:
        f.seek(0, 2); f.seek(max(0, f.tell() - 400000)); lines = f.read().decode("utf-8", "ignore").splitlines()
    for l in reversed(lines):
        if "\"usage\"" not in l: continue
        u = json.loads(l).get("message", {}).get("usage") or {}
        n = sum(u.get(k, 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        if n: print(f"{round(n / 1000)}k"); break
except Exception:
    pass'
}
case "$kind" in
  busy)
    [[ -n "$($T show -t "=$s:" -qv @busy_since)" ]] || $T set -t "=$s:" @busy_since "$(date +%s)"
    $T set -t "=$s:" @busy 1; refresh
    # Esc로 중단하면 Stop 훅이 안 와서 작업 중 표시가 남는다(idle_prompt 알림도 안 옴, 2026-11-06 확인).
    # 그래서 작업 중인 동안 15초마다 화면을 보고, claude의 진행 표시줄("… (12s ·" 같은 것)도 없고 화면도 그대로인 게
    # 두 번 연속이면 끈다. 화면 변화도 보는 건 claude 업데이트로 진행 표시 문구가 바뀌어도 작업 중을 놓치지 않게 하려는 것.
    pidf=@@HOME@@/.cache/cchat-busy/$s.pid; mkdir -p ${pidf:h}
    if ! { [[ -f $pidf ]] && kill -0 "$(<$pidf)" 2>/dev/null; }; then
      (
        miss=0 last=""
        while sleep ${CCHAT_BUSY_POLL:-15}; do
          [[ -n "$($T show -t "=$s:" -qv @busy 2>/dev/null)" ]] || break
          scr=$($T capture-pane -p -t "$TMUX_PANE" 2>/dev/null | sed '$d' | sed '$d')  # 맨 아래 2줄(상태줄: 시계 등)은 빼고 비교
          if print -r -- "$scr" | grep -qE '… \(([0-9]+h )?([0-9]+m )?[0-9]+s|esc to interrupt' || [[ -n "$last" && "$scr" != "$last" ]]; then miss=0
          else (( ++miss >= 2 )) && { $T set -u -t "=$s:" @busy; $T set -u -t "=$s:" @busy_since; refresh; print -r -- "$(date '+%m-%d %T') busy-off s=$s (진행 표시·화면 변화 없음)" >>@@HOME@@/Library/Logs/cchat-unread.log; break; }; fi
          last=$scr
        done
        rm -f $pidf
      ) </dev/null >/dev/null 2>&1 &!
      print $! > $pidf
    fi
    exit 0 ;;
  idle) [[ -n "$($T show -t "=$s:" -qv @busy)" ]] && { $T set -u -t "=$s:" @busy; $T set -u -t "=$s:" @busy_since; refresh; }; exit 0 ;;
esac
# 답이 글로 묻고 끝났으면("진행할까요?", "정해 주세요") 녹색이 아니라 주황(내 차례)으로 본다.
# 질문 도구를 안 쓰고 글로 묻는 턴이 많아(11-09 대화 171턴 중 63턴) 주황이 거의 안 나오던 것.
qdet=""
if [[ $kind == done ]]; then
  qdet=$(print -r -- "$input" | /usr/bin/python3 -I -c '
import json, os, re, sys
try:
    d = json.loads(sys.stdin.read() or "{}")
except Exception:
    d = {}
text = d.get("last_assistant_message") or ""
if not text and d.get("transcript_path"):
    try:
        with open(os.path.expanduser(d["transcript_path"]), "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 400000)); lines = f.read().decode("utf-8", "ignore").splitlines()
        for l in reversed(lines):
            o = json.loads(l) if l.startswith("{") else {}
            if o.get("type") != "assistant" or o.get("isSidechain"): continue
            t = [x.get("text", "") for x in (o.get("message", {}).get("content") or []) if isinstance(x, dict) and x.get("type") == "text"]
            if any(x.strip() for x in t): text = "\n".join(t); break
    except Exception:
        pass
last = [l.strip(" *_`>-") for l in text.strip().splitlines() if l.strip()][-2:]  # 마지막 두 줄(질문 뒤에 한 줄 덧붙이는 경우)
# 결정을 묻는 문장만 본다: "?"·"~까요"로 끝남, "정해/골라/결정해/답해 주세요", "~할지(…) 말씀해/알려 주세요".
# 인사성 마무리("원하시면/있으면/필요하면 …", "고칠 곳을 말씀해 주세요", "열어 봐 주세요")는 녹색 그대로.
END = re.compile(r"(\?|까요)[\s.!)\"」”]*$")
DECIDE = re.compile(r"(정해|골라|결정해|답해) ?(주세요|주시면|주셔야)|정하시면 됩니다")
ASKWORD = re.compile(r"(말씀해|알려|정해|답해) ?(주세요|주시면|주셔야)")
POLITE = re.compile(r"(있으면|있다면|필요하면|필요하시면|원하시면|궁금하|더 필요)")
def rieul_ji(t):  # "할지·지울지·넣을지"처럼 ㄹ받침 + "지"(고르게 하는 말)
    return any(t[k] == "지" and 0xAC00 <= ord(t[k - 1]) <= 0xD7A3 and (ord(t[k - 1]) - 0xAC00) % 28 == 8 for k in range(1, len(t)))
def asks(t):
    if POLITE.search(t): return False
    return bool(END.search(t) or DECIDE.search(t) or (rieul_ji(t) and ASKWORD.search(t)))
for l in reversed(last):
    for sent in reversed(re.split(r"(?<=[.?!])\s+", l)):
        if asks(sent):
            print(sent[:120]); sys.exit()
' 2>/dev/null)
  [[ -n "$qdet" ]] && kind=ask
fi
$T set -u -t "=$s:" @busy
[[ $kind == done || -n "$qdet" ]] && $T set -u -t "=$s:" @busy_since
c=$(ctx_from_transcript); [[ -n "$c" ]] && $T set -t "=$s:" @ctx "$c"
now=$(date +%s)
focus_idle=$($T show -gqv @cchat_focus_idle)  # 기본 600초(시험에서 줄임)
view_idle=$($T show -gqv @cchat_view_idle)    # 기본 120초
viewing=""
while read -r sess act flags; do
  [[ "$sess" == "$s" ]] || continue
  # 포커스만 있고 10분 넘게 입력이 없으면 자리를 비운 것으로 본다(창을 띄워 둔 채 나가면 표시·알림이 다 막히던 것).
  if { [[ ",$flags," == *,focused,* ]] && (( now - act < ${focus_idle:-600} )); } || (( now - act < ${view_idle:-120} )); then viewing=yes; break; fi
done < <($T list-clients -F '#{client_session} #{client_activity} #{client_flags}')
LOG=@@HOME@@/Library/Logs/cchat-unread.log
print -r -- "$(date '+%m-%d %T') $kind${qdet:+(글 질문)} s=$s viewing=${viewing:-no}" >>$LOG
[[ -n "$viewing" ]] && { refresh; exit 0; }
$T set -t "=$s:" @unread "$kind"
refresh
# 선택: ~/.config/cchat/notify <세션> <done|ask> 가 있으면 백그라운드로 불러 폰·PC 알림을 보낸다(없으면 아무것도 안 함).
# 보낼지·어느 기기로 보낼지는 cchat-set 설정(알림 켜기/끄기, 기기·종류별, 방해 금지 시간)을 따른다.
N=@@HOME@@/.config/cchat/notify
# 훅에는 무엇을 묻는지(ask: 허락 창 위 줄들) 또는 마지막 답 한 줄(done: "● …")을 CCHAT_NOTIFY_DETAIL로 넘기고,
# 도구 허락 창("Do you want …")이면 CCHAT_NOTIFY_ACTIONS=1(알림에서 허용·거절)과 그 칸(CCHAT_NOTIFY_PANE)을 넘긴다.
if [[ -x $N ]]; then
  devs=$(@@HOME@@/.local/bin/cchat-set --devices-for "$kind")
  if [[ -n "$devs" ]]; then
    (
      [[ $kind == ask ]] && sleep 1.5  # 허락 창이 그려진 뒤에 읽는다(훅은 창보다 먼저 불린다)
      scr=$($T capture-pane -p -t "$TMUX_PANE" 2>/dev/null)
      det=$(print -r -- "$scr" | /usr/bin/python3 -I -c '
import re, sys
kind = sys.argv[1]
raw = sys.stdin.read().splitlines()
lines = [l.strip(" │|╭╮╰╯\t") for l in raw]
lines = [l for l in lines if l and not re.fullmatch(r"[\u2500-\u257f\-=_ ]+", l)]  # 가로선·점선(╌) 줄 빼기
out = ""
if kind == "ask":
    i = next((k for k, l in enumerate(lines) if l.startswith("Do you want") or re.match(r"^(❯\s*)?1\.\s", l)), None)
    if i:
        out = " · ".join(lines[max(0, i - 2):i])
else:
    # claude 답은 맨 앞 칸부터 "● "로 시작한다(입력칸 위 오른쪽의 "● high · /effort" 같은 표시는 앞에 공백이 있다)
    out = next((l[2:].strip() for l in reversed(raw) if l.startswith("● ")), "")
print(out[:120])' "$kind")
      [[ -n "$qdet" ]] && det=$qdet  # 글로 물은 질문이면 그 문장을 알림에 그대로
      act=""
      [[ $kind == ask && "$scr" == *"Do you want"* ]] && act=1
      CCHAT_NOTIFY_DEVICES="$devs" CCHAT_NOTIFY_DETAIL="$det" CCHAT_NOTIFY_ACTIONS="$act" CCHAT_NOTIFY_PANE="$TMUX_PANE" $N "$s" "$kind"
    ) </dev/null >/dev/null 2>&1 &!
  fi
fi
exit 0
